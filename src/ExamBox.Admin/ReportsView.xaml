<UserControl x:Class="ExamBox.Admin.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:ExamBox.Admin"
             xmlns:local="clr-namespace:ExamBox.Admin">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel LastChildFill="False" Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Reports" Style="{StaticResource H1}"/>
                    <TextBlock Text="Results across your exams, filter, explore and export." Style="{StaticResource Muted}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="ExamFilter" Width="220" Margin="0,0,10,0" SelectionChanged="Filter_Changed"/>
                    <ComboBox x:Name="PeriodFilter" Width="160" Margin="0,0,12,0" SelectedIndex="3" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="Last 30 days"/>
                        <ComboBoxItem Content="Last 90 days"/>
                        <ComboBoxItem Content="Last 12 months"/>
                        <ComboBoxItem Content="All time"/>
                    </ComboBox>
                    <Button Style="{StaticResource PrimaryButton}" Click="Export_Click" Margin="0">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Export CSV" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <Border x:Name="PendingBanner" Background="{StaticResource WarnBgBrush}" CornerRadius="12" Padding="16,11" Margin="0,0,0,14" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Go to marking" Style="{StaticResource GhostButton}" Click="Marking_Click" Margin="12,0,0,0" Padding="12,5"/>
                    <TextBlock x:Name="PendingText" Foreground="{StaticResource WarnBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <UniformGrid x:Name="KpiRow" r:Responsive.CellWidth="215">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Background="#3D8BFF" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="KpiAttempts" Style="{StaticResource StatNumber}"/>
                            <TextBlock Text="Submissions" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="KpiAttemptsSub" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Background="#7B61FF" VerticalAlignment="Center">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="KpiAvg" Style="{StaticResource StatNumber}"/>
                            <TextBlock Text="Average score" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="KpiAvgSub" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Background="#19B58A" VerticalAlignment="Center">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="KpiPass" Style="{StaticResource StatNumber}"/>
                            <TextBlock Text="Pass rate" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="KpiPassSub" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Background="#F2A900" VerticalAlignment="Center">
                            <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="KpiHigh" Style="{StaticResource StatNumber}"/>
                            <TextBlock Text="Highest score" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="KpiHighSub" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,16,0,0" r:Responsive.StackBelow="1000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" MinWidth="380"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.35*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Grade distribution" Style="{StaticResource H2}"/>
                        <TextBlock Text="How submissions are spread across grades" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <local:DonutChart x:Name="Donut" Width="200" Height="200"/>
                            <StackPanel x:Name="Legend" Grid.Column="1" VerticalAlignment="Center" Margin="22,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" x:Name="PassDot" Margin="0,0,6,0"/><TextBlock Text="Passed" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,16,0"/>
                                <Ellipse Width="10" Height="10" x:Name="FailDot" Margin="0,0,6,0"/><TextBlock Text="Failed" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Pass / fail trend" Style="{StaticResource H2}"/>
                                <TextBlock Text="Submissions per month, last 6 months" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <local:LineChart x:Name="Trend" Height="214" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,22,0,0" r:Responsive.StackBelow="1100">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
<TextBlock Text="Exam performance" Style="{StaticResource H2}" Margin="0,0,0,10"/>
            <Border Style="{StaticResource GridCard}">
                <Grid>
                    <DataGrid x:Name="ExamsTable" RowHeight="52" MinHeight="120" MaxHeight="520">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="EXAM" Binding="{Binding Exam}" Width="2*"/>
                            <DataGridTextColumn Header="ATTEMPTS" Binding="{Binding Attempts}" Width="100"/>
                            <DataGridTextColumn Header="AVERAGE" Binding="{Binding Average}" Width="100"/>
                            <DataGridTemplateColumn Header="PASS RATE" Width="1.2*" SortMemberPath="PassRate">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ProgressBar Style="{StaticResource SlimProgress}" Value="{Binding PassRate, Mode=OneWay}" Maximum="100" Width="80"/>
                                            <TextBlock Text="{Binding PassRateText}" FontWeight="SemiBold" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="HIGHEST" Binding="{Binding High}" Width="100"/>
                            <DataGridTextColumn Header="LOWEST" Binding="{Binding Low}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="ExamsEmpty" Text="No submissions match these filters yet." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </Border>

                            </StackPanel>
                <StackPanel Grid.Column="2">
<TextBlock Text="Top students" Style="{StaticResource H2}" Margin="0,0,0,10"/>
            <Border Style="{StaticResource GridCard}" Margin="0,0,0,12">
                <Grid>
                    <DataGrid x:Name="TopTable" RowHeight="54" MinHeight="120" MaxHeight="480">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="56"/>
                            <DataGridTemplateColumn Header="STUDENT" Width="2*" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource BlueLightBrush}">
                                                <TextBlock Text="{Binding Initial}" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                                                        <DataGridTextColumn Header="EXAMS" Binding="{Binding Exams}" Width="80"/>
                            <DataGridTextColumn Header="AVERAGE" Binding="{Binding Average}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="TopEmpty" Text="Top students appear once exams are submitted." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
