<UserControl x:Class="ExamBox.Admin.ClassesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:ExamBox.Admin">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Classes" Style="{StaticResource H1}"/>
                <TextBlock x:Name="Sub" Style="{StaticResource Muted}"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="Add_Click" Margin="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="New class" VerticalAlignment="Center"/></StackPanel>
            </Button>
        </DockPanel>
        <UniformGrid DockPanel.Dock="Top" r:Responsive.CellWidth="215">
                <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,12,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12" Background="#3D8BFF" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatClasses" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="Classes" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,12,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12" Background="#19B58A" VerticalAlignment="Center">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatPlaced" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="Students placed" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,12,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12" Background="#F2A900" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatNone" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="Without a class" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,13" Margin="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12" Background="#8B5CF6" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatExams" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="Exams for a class" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
        </UniformGrid>
        <DockPanel DockPanel.Dock="Top" Margin="0,18,0,12">
            <TextBlock x:Name="Count" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal">
                <Grid Width="300" Margin="0,0,14,0">
                    <TextBox x:Name="Search" Padding="40,9,12,9" TextChanged="Search_Changed"/>
                    <TextBlock Text="&#xE721;" Style="{StaticResource IconGlyph}" FontSize="15" Foreground="#8B97B5" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock x:Name="SearchHint" Text="Search classes" Foreground="#A3AECA" VerticalAlignment="Center" Margin="41,0,0,0" IsHitTestVisible="False"/>
                </Grid>
            </StackPanel>
        </DockPanel>
        <Border x:Name="TableCard" Style="{StaticResource GridCard}">
            <Grid>
                <DataGrid x:Name="Table" RowHeight="60" MouseDoubleClick="Grid_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="CLASS" Width="2*" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="38" Height="38" CornerRadius="11" Background="#F1ECFF"><TextBlock Text="&#xE8FD;" Style="{StaticResource IconGlyph}" FontSize="16" Foreground="#5B3FD1"/></Border>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="STUDENTS" Binding="{Binding Students}" Width="*"/>
                        <DataGridTextColumn Header="EXAMS FOR THIS CLASS" Binding="{Binding Exams}" Width="*"/>
                        <DataGridTextColumn Header="CREATED" Binding="{Binding Created}" Width="*"/>
                        <DataGridTemplateColumn Header="" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="&#xE70F;" ToolTip="Rename class" Style="{StaticResource IconButtonBlue}" Click="Rename_Click"/>
                                        <Button Content="&#xE74D;" ToolTip="Delete class" Style="{StaticResource IconButtonDanger}" Click="Delete_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,30">
                    <Border Style="{StaticResource IllustrationPanel}" Width="300" HorizontalAlignment="Center"><Image Source="/Assets/admin-students.png"/></Border>
                    <TextBlock Text="No classes yet" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,18,0,4"/>
                    <TextBlock Text="Create classes such as SS1 or JSS2, then pick one when adding students and exams." Style="{StaticResource Muted}" TextAlignment="Center" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
