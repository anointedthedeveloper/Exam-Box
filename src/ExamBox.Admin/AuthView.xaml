<UserControl x:Class="ExamBox.Admin.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*"/>
            <ColumnDefinition Width="1*" MinWidth="480"/>
        </Grid.ColumnDefinitions>

        <!-- brand panel -->
        <Border Grid.Column="0" Background="{StaticResource HeroBrush}" ClipToBounds="True">
            <Grid>
                <Ellipse Width="620" Height="620" Fill="White" Opacity="0.06" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-220,-230,0"/>
                <Ellipse Width="460" Height="460" Fill="White" Opacity="0.05" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-180,0,0,-190"/>
                <StackPanel VerticalAlignment="Center" Margin="80,0,60,0" HorizontalAlignment="Left">
                    <Border Background="White" CornerRadius="30" Width="150" Height="150" Padding="8" HorizontalAlignment="Left" Effect="{StaticResource SoftShadow}">
                        <Image Source="/Assets/logo.png"/>
                    </Border>
                    <TextBlock Text="ExamBox" Foreground="White" FontSize="48" FontWeight="ExtraBold" Margin="0,26,0,6"/>
                    <TextBlock Text="Run exams, manage students and grade results — all in one box."
                               Foreground="#DBE6FF" FontSize="18" TextWrapping="Wrap" MaxWidth="440" HorizontalAlignment="Left"/>
                    <StackPanel Margin="0,30,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="30" Height="30" CornerRadius="15" Background="#26FFFFFF"><TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="Timed multiple-choice exams with instant grading" Foreground="#E4ECFF" FontSize="15" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="30" Height="30" CornerRadius="15" Background="#26FFFFFF"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="Students sit exams from any browser on your network" Foreground="#E4ECFF" FontSize="15" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="15" Background="#26FFFFFF"><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="Everything stays on this computer" Foreground="#E4ECFF" FontSize="15" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- form -->
        <Border Grid.Column="1" Background="{StaticResource BgBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalAlignment="Center">
                <Border Background="White" CornerRadius="18" Width="430" Margin="24" Padding="34,32" Effect="{StaticResource SoftShadow}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="Heading" Style="{StaticResource H1}" FontSize="26"/>
                        <TextBlock x:Name="SubHeading" Style="{StaticResource Muted}" Margin="0,6,0,6" FontSize="14"/>

                        <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="Username"/>

                        <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <PasswordBox x:Name="Password"/>
                            <TextBox x:Name="PasswordVisible" Visibility="Collapsed"/>
                        </Grid>
                        <CheckBox x:Name="ShowPw" Content="Show password" Margin="0,10,0,0" Checked="ShowPw_Changed" Unchecked="ShowPw_Changed"/>

                        <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
                            <TextBlock Text="Confirm password" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="Confirm"/>
                        </StackPanel>

                        <CheckBox x:Name="RememberMe" Content="Remember me" Margin="0,14,0,0"/>

                        <Border x:Name="ErrorBox" Background="{StaticResource ErrBgBrush}" CornerRadius="9" Padding="12,9" Margin="0,16,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Border>

                        <Button x:Name="Submit" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Submit_Click" Margin="0,22,0,0" Padding="16,12" FontSize="15"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
