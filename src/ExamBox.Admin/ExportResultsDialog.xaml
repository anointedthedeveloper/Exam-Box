<Window UseLayoutRounding="True" SnapsToDevicePixels="True" x:Class="ExamBox.Admin.ExportResultsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="640" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource PageBackgroundBrush}" FontFamily="Segoe UI">
    <Grid>
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="340" Height="340" Fill="{StaticResource OrbBlueBrush}" Canvas.Right="-120" Canvas.Top="-130"/>
            <Ellipse Width="300" Height="300" Fill="{StaticResource OrbPurpleBrush}" Canvas.Left="-110" Canvas.Bottom="-120"/>
        </Canvas>
        <Border Background="{StaticResource FrostBrush}" CornerRadius="16" Margin="12" BorderBrush="#B3FFFFFF" BorderThickness="1.5">
            <StackPanel Margin="26">
                <StackPanel Orientation="Horizontal"><Border Style="{StaticResource IconBadge}"><TextBlock Text="&#xE896;" Style="{StaticResource IconGlyph}"/></Border><TextBlock Text="Export results" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
                <TextBlock Text="Choose the classes and subjects to include. Results of the chosen subjects for students in the chosen classes are put in one file, grouped by class." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <DockPanel><Button DockPanel.Dock="Right" Content="All" Style="{StaticResource GhostButton}" Click="AllClasses_Click" Padding="10,2" Margin="0"/><TextBlock Text="Classes" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/></DockPanel>
                        <Border Background="#80FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Height="220"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ClassList" Margin="12,8"/></ScrollViewer></Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <DockPanel><Button DockPanel.Dock="Right" Content="All" Style="{StaticResource GhostButton}" Click="AllSubjects_Click" Padding="10,2" Margin="0"/><TextBlock Text="Subjects" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/></DockPanel>
                        <Border Background="#80FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Height="220"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SubjectList" Margin="12,8"/></ScrollViewer></Border>
                    </StackPanel>
                </Grid>
                <TextBlock Text="File type" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FmtPdf" Content="PDF (recommended)" IsChecked="True" GroupName="fmt" Margin="0,0,22,0"/>
                    <RadioButton x:Name="FmtXlsx" Content="Excel" GroupName="fmt" Margin="0,0,22,0"/>
                    <RadioButton x:Name="FmtCsv" Content="CSV" GroupName="fmt"/>
                </StackPanel>
                <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True"/>
                    <Button Content="Export" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Export_Click" Margin="0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
