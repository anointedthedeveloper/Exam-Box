<Window x:Class="ExamBox.Admin.QuestionDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BgBrush}" FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="720">
        <StackPanel Margin="26">
            <TextBlock x:Name="Heading" Style="{StaticResource H2}"/>
            <TextBlock Text="Question" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="QText" AcceptsReturn="True" TextWrapping="Wrap" Height="80" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
            <TextBlock Text="Option A" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="OptA"/>
            <TextBlock Text="Option B" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="OptB"/>
            <TextBlock Text="Option C (optional)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="OptC"/>
            <TextBlock Text="Option D (optional)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="OptD"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Correct answer" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="Correct" SelectedIndex="0">
                        <ComboBoxItem Content="A"/>
                        <ComboBoxItem Content="B"/>
                        <ComboBoxItem Content="C"/>
                        <ComboBoxItem Content="D"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Marks" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="Marks" Text="1"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True"/>
                <Button x:Name="SaveBtn" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" Margin="0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
