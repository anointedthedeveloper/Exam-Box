<Window UseLayoutRounding="True" SnapsToDevicePixels="True" x:Class="ExamBox.Admin.QuestionDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="600" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource PageBackgroundBrush}" FontFamily="Segoe UI">
    <Grid>
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="340" Height="340" Fill="{StaticResource OrbBlueBrush}" Canvas.Right="-120" Canvas.Top="-130"/>
            <Ellipse Width="300" Height="300" Fill="{StaticResource OrbPurpleBrush}" Canvas.Left="-110" Canvas.Bottom="-120"/>
        </Canvas>
        <Border Background="{StaticResource FrostBrush}" CornerRadius="16" Margin="12" BorderBrush="#B3FFFFFF" BorderThickness="1.5">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="760">
        <StackPanel Margin="26">
            <StackPanel Orientation="Horizontal"><Border Style="{StaticResource IconBadge}"><TextBlock Text="&#xE897;" Style="{StaticResource IconGlyph}"/></Border><TextBlock x:Name="Heading" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Type" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="TypeBox" SelectedIndex="0" SelectionChanged="Type_Changed">
                        <ComboBoxItem Content="Objective (multiple choice)"/>
                        <ComboBoxItem Content="Theory (typed answer)"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Number (optional)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="Number" ToolTip="Shown to students, e.g. 1, 2 or 3a. Leave blank to number automatically."/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Marks" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="Marks" Text="1"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="Question" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="QText" Style="{StaticResource MultiLineTextBox}" Height="90"/>
            <StackPanel x:Name="ObjPanel">
                <TextBlock Text="Option A" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="OptA"/>
                <TextBlock Text="Option B" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="OptB"/>
                <TextBlock Text="Option C (optional)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="OptC"/>
                <TextBlock Text="Option D (optional)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="OptD"/>
                <TextBlock Text="Option E (optional)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="OptE"/>
                <TextBlock Text="Correct answer" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="Correct" SelectedIndex="0" Width="120" HorizontalAlignment="Left">
                    <ComboBoxItem Content="A"/><ComboBoxItem Content="B"/><ComboBoxItem Content="C"/><ComboBoxItem Content="D"/><ComboBoxItem Content="E"/>
                </ComboBox>
            </StackPanel>
            <StackPanel x:Name="TheoryPanel" Visibility="Collapsed">
                <TextBlock Text="Marking guide / model answer (optional, shown to you while marking)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ModelAnswer" Style="{StaticResource MultiLineTextBox}" Height="90"/>
                <TextBlock Text="Tip: for sub-parts, add each as its own question and number them 1a, 1b, 1c. Set marks to 0 for a reading passage that students only read." Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
            <TextBlock Text="Picture (optional)" Style="{StaticResource FieldLabel}"/>
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="120" Height="80" CornerRadius="10" Background="#80FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,14,0">
                    <Grid>
                        <Image x:Name="Preview" Stretch="Uniform" Margin="4"/>
                        <TextBlock x:Name="NoPic" Text="No picture" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Choose picture…" Style="{StaticResource GhostButton}" Click="Pick_Click" Margin="0,0,8,0"/>
                        <Button x:Name="RemovePic" Content="Remove" Style="{StaticResource DangerButton}" Click="Remove_Click" Margin="0" Visibility="Collapsed"/>
                    </StackPanel>
                    <CheckBox x:Name="NeedPic" Content="This question needs a picture (block launch until attached)" Margin="0,10,0,0"/>
                </StackPanel>
            </DockPanel>
            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True"/>
                <Button x:Name="SaveBtn" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" Margin="0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
        </Border>
    </Grid>
</Window>
