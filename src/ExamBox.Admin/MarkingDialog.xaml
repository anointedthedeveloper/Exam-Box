<Window UseLayoutRounding="True" SnapsToDevicePixels="True" x:Class="ExamBox.Admin.MarkingDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="760" Height="720" MinHeight="480" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource PageBackgroundBrush}" FontFamily="Segoe UI">
    <Grid>
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="340" Height="340" Fill="{StaticResource OrbBlueBrush}" Canvas.Right="-120" Canvas.Top="-130"/>
            <Ellipse Width="300" Height="300" Fill="{StaticResource OrbPurpleBrush}" Canvas.Left="-110" Canvas.Bottom="-120"/>
        </Canvas>
        <Border Background="{StaticResource FrostBrush}" CornerRadius="16" Margin="12" BorderBrush="#B3FFFFFF" BorderThickness="1.5">
            <DockPanel Margin="26,22,26,22">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal"><Border Style="{StaticResource IconBadge}"><TextBlock Text="&#xE70F;" Style="{StaticResource IconGlyph}"/></Border><TextBlock x:Name="Heading" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
                    <TextBlock x:Name="Sub" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,10"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>
                    <DockPanel Margin="0,16,0,0" LastChildFill="False">
                        <TextBlock x:Name="Total" DockPanel.Dock="Left" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" x:Name="FinishBtn" Content="Finish marking" Style="{StaticResource PrimaryButton}" Click="Finish_Click" Margin="0"/>
                        <Button DockPanel.Dock="Right" Content="Save progress" Style="{StaticResource GhostButton}" Click="SaveProgress_Click"/>
                        <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource GhostButton}" IsCancel="True"/>
                    </DockPanel>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Items"/></ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
