<Window x:Class="ExamBox.Admin.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ExamBox.Admin"
        Title="ExamBox" Width="520" Height="340" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True" Icon="/Assets/logo.ico"
        FontFamily="Segoe UI">
    <Border Background="{StaticResource HeroBrush}" CornerRadius="22" Margin="22" Effect="{StaticResource SoftShadow}" ClipToBounds="True">
        <Grid>
            <Ellipse Width="320" Height="320" Fill="White" Opacity="0.07" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-130,-110,0"/>
            <Ellipse Width="240" Height="240" Fill="White" Opacity="0.05" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-90,0,0,-100"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Style="{StaticResource LogoBadge}" CornerRadius="26" Width="116" Height="116" Padding="18" HorizontalAlignment="Center">
                    <Image Source="/Assets/logo.png"/>
                </Border>
                <TextBlock Text="ExamBox" Foreground="White" FontSize="32" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <local:Spinner Foreground="White" Width="20" Height="20"/>
                    <TextBlock x:Name="Status" Text="Starting…" Foreground="#DBE6FF" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
