<Window UseLayoutRounding="True" SnapsToDevicePixels="True" x:Class="ExamBox.Admin.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ExamBox" Width="580" Height="400" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True" Icon="/Assets/logo.ico"
        FontFamily="Segoe UI" Opacity="0">
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35"/>
                    <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleX" From="0.7" To="1" Duration="0:0:0.6"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleY" From="0.7" To="1" Duration="0:0:0.6"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="Ring1Scale" Storyboard.TargetProperty="ScaleX" From="0.75" To="1.7" Duration="0:0:2.2"/>
                    <DoubleAnimation Storyboard.TargetName="Ring1Scale" Storyboard.TargetProperty="ScaleY" From="0.75" To="1.7" Duration="0:0:2.2"/>
                    <DoubleAnimation Storyboard.TargetName="Ring1" Storyboard.TargetProperty="Opacity" From="0.45" To="0" Duration="0:0:2.2"/>
                    <DoubleAnimation Storyboard.TargetName="Ring2Scale" Storyboard.TargetProperty="ScaleX" From="0.75" To="1.7" Duration="0:0:2.2" BeginTime="0:0:1.1"/>
                    <DoubleAnimation Storyboard.TargetName="Ring2Scale" Storyboard.TargetProperty="ScaleY" From="0.75" To="1.7" Duration="0:0:2.2" BeginTime="0:0:1.1"/>
                    <DoubleAnimation Storyboard.TargetName="Ring2" Storyboard.TargetProperty="Opacity" From="0.45" To="0" Duration="0:0:2.2" BeginTime="0:0:1.1"/>
                </Storyboard>
            </BeginStoryboard>
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="ShimmerMove" Storyboard.TargetProperty="X" From="-100" To="260" Duration="0:0:1.3"/>
                </Storyboard>
            </BeginStoryboard>
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="OrbA" Storyboard.TargetProperty="X" From="0" To="-50" Duration="0:0:6" AccelerationRatio="0.4" DecelerationRatio="0.4"/>
                    <DoubleAnimation Storyboard.TargetName="OrbA" Storyboard.TargetProperty="Y" From="0" To="40" Duration="0:0:6" AccelerationRatio="0.4" DecelerationRatio="0.4"/>
                    <DoubleAnimation Storyboard.TargetName="OrbB" Storyboard.TargetProperty="X" From="0" To="60" Duration="0:0:7" AccelerationRatio="0.4" DecelerationRatio="0.4"/>
                    <DoubleAnimation Storyboard.TargetName="OrbB" Storyboard.TargetProperty="Y" From="0" To="-40" Duration="0:0:7" AccelerationRatio="0.4" DecelerationRatio="0.4"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Border Background="{StaticResource AdminHeroBrush}" CornerRadius="26" Margin="24" Effect="{StaticResource SoftShadow}" ClipToBounds="True">
        <Grid>
            <Ellipse Width="420" Height="420" Fill="{StaticResource OrbGlowBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-170,-130,0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="OrbA"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="360" Height="360" Fill="{StaticResource OrbPurpleBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-120,0,0,-150">
                <Ellipse.RenderTransform><TranslateTransform x:Name="OrbB"/></Ellipse.RenderTransform>
            </Ellipse>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-6,0,0">
                <Grid Width="160" Height="150" HorizontalAlignment="Center">
                    <Ellipse x:Name="Ring1" Width="110" Height="110" Stroke="White" StrokeThickness="2" Opacity="0.45" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="Ring1Scale"/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="Ring2" Width="110" Height="110" Stroke="White" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="Ring2Scale"/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Border Style="{StaticResource LogoBadge}" CornerRadius="28" Width="112" Height="112" Padding="18" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="LogoScale"/></Border.RenderTransform>
                        <Image Source="/Assets/logo.png"/>
                    </Border>
                </Grid>
                <TextBlock Text="ExamBox" Foreground="White" FontSize="36" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                <TextBlock Text="Exams, made simple" Foreground="#C9D8FF" FontSize="14" HorizontalAlignment="Center" Margin="0,2,0,0"/>

                <Border Width="250" Height="5" CornerRadius="3" Background="#33FFFFFF" Margin="0,26,0,0" ClipToBounds="True">
                    <Border Width="100" HorizontalAlignment="Left" CornerRadius="3">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                <GradientStop Color="#FFFFFFFF" Offset="0.5"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform><TranslateTransform x:Name="ShimmerMove" X="-100"/></Border.RenderTransform>
                    </Border>
                </Border>
                <TextBlock x:Name="Status" Text="Starting…" Foreground="#C9D8FF" FontSize="13" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>

            <TextBlock x:Name="VersionText" Foreground="#8FB0F5" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="26,0,0,18"/>
            <TextBlock Text="Everything stays on this computer" Foreground="#8FB0F5" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,26,18"/>
        </Grid>
    </Border>
</Window>
