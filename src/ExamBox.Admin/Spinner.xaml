<UserControl x:Class="ExamBox.Admin.Spinner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="22" Height="22" Foreground="{StaticResource BlueBrush}" IsHitTestVisible="False">
    <Grid RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <RotateTransform x:Name="Rot"/>
        </Grid.RenderTransform>
        <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" Opacity="0.25" StrokeThickness="3" Margin="1.5"/>
        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 11,1.5 A 9.5,9.5 0 0 1 20.5,11"/>
    </Grid>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="Rot" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.85"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
