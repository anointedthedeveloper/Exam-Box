<UserControl x:Class="ExamBox.Admin.OnlineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:ExamBox.Admin">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Online now" Style="{StaticResource H1}"/>
                <TextBlock x:Name="Sub" Style="{StaticResource Muted}"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Click="All_Click" Margin="0" VerticalAlignment="Center" Content="Sign out all students"/>
        </DockPanel>
        <UniformGrid DockPanel.Dock="Top" r:Responsive.CellWidth="215">
                <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,12,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12" Background="#19B58A" VerticalAlignment="Center">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatOnline" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="Online now" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,12,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12" Background="#3D8BFF" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatSitting" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="Sitting an exam" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,12,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12" Background="#F2A900" VerticalAlignment="Center">
                            <TextBlock Text="&#xE769;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatPaused" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="Paused exams" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,13" Margin="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12" Background="#8B5CF6" VerticalAlignment="Center">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatTotal" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="Students in total" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
        </UniformGrid>
        <DockPanel DockPanel.Dock="Top" Margin="0,18,0,12">
            <TextBlock x:Name="Count" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal">
                <Grid Width="300" Margin="0,0,14,0">
                    <TextBox x:Name="Search" Padding="40,9,12,9" TextChanged="Search_Changed"/>
                    <TextBlock Text="&#xE721;" Style="{StaticResource IconGlyph}" FontSize="15" Foreground="#8B97B5" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock x:Name="SearchHint" Text="Search online students" Foreground="#A3AECA" VerticalAlignment="Center" Margin="41,0,0,0" IsHitTestVisible="False"/>
                </Grid>
            </StackPanel>
        </DockPanel>
        <Border x:Name="TableCard" Style="{StaticResource GridCard}">
            <Grid>
                <DataGrid x:Name="Table" RowHeight="58">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="STUDENT" Width="2*" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Fill="{StaticResource OkBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="STUDENT ID" Binding="{Binding Code}" Width="*"/>
                        <DataGridTextColumn Header="CLASS" Binding="{Binding Class}" Width="*"/>
                        <DataGridTextColumn Header="DOING" Binding="{Binding Doing}" Width="2*"/>
                        <DataGridTextColumn Header="LAST SEEN" Binding="{Binding Seen}" Width="*"/>
                        <DataGridTemplateColumn Header="" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="&#xE7E8;" ToolTip="Sign out this student" Style="{StaticResource IconButtonDanger}" Click="Out_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,40">
                    <Border Style="{StaticResource IllustrationPanel}" Width="300" HorizontalAlignment="Center"><Image Source="/Assets/slide-devices.png"/></Border>
                    <TextBlock Text="Nobody is online" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,18,0,4"/>
                    <TextBlock Text="Students appear here while they have the portal open. Updates every 5 seconds." Style="{StaticResource Muted}" TextAlignment="Center" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
