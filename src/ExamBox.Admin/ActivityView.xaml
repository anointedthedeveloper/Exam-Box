<UserControl x:Class="ExamBox.Admin.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Activity log" Style="{StaticResource H1}"/>
                <TextBlock x:Name="Sub" Style="{StaticResource Muted}"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="Export_Click" Margin="0" VerticalAlignment="Center" Content="Export CSV"/>
        </DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Grid Width="300" Margin="0,0,14,0">
                    <TextBox x:Name="Search" Padding="40,9,12,9" TextChanged="Search_Changed"/>
                    <TextBlock Text="&#xE721;" Style="{StaticResource IconGlyph}" FontSize="15" Foreground="#8B97B5" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock x:Name="SearchHint" Text="Search who, event or details" Foreground="#A3AECA" VerticalAlignment="Center" Margin="41,0,0,0" IsHitTestVisible="False"/>
                </Grid>
                <Border Background="#1A305AB4" CornerRadius="10" Padding="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="FAll" Content="All" GroupName="af" IsChecked="True" Style="{StaticResource SegmentButton}" Click="Filter_Click"/>
                        <RadioButton x:Name="FIn" Content="Sign-ins" GroupName="af" Style="{StaticResource SegmentButton}" Click="Filter_Click"/>
                        <RadioButton x:Name="FExam" Content="Exams" GroupName="af" Style="{StaticResource SegmentButton}" Click="Filter_Click"/>
                        <RadioButton x:Name="FAdmin" Content="Admin" GroupName="af" Style="{StaticResource SegmentButton}" Click="Filter_Click"/>
                        <RadioButton x:Name="FFail" Content="Failed" GroupName="af" Style="{StaticResource SegmentButton}" Click="Filter_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>
        <Border Style="{StaticResource GridCard}">
            <Grid>
                <DataGrid x:Name="Table" RowHeight="46" VerticalAlignment="Top">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TIME" Binding="{Binding Time}" Width="170"/>
                        <DataGridTemplateColumn Header="TYPE" Width="120" SortMemberPath="Kind">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="11,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource BlueLightBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="signin"><Setter Property="Background" Value="{StaticResource OkBgBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="failed"><Setter Property="Background" Value="{StaticResource ErrBgBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="signout"><Setter Property="Background" Value="{StaticResource WarnBgBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="exam"><Setter Property="Background" Value="#F1ECFF"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="WHO" Binding="{Binding Actor}" Width="*"/>
                        <DataGridTextColumn Header="EVENT" Binding="{Binding Event}" Width="1.6*"/>
                        <DataGridTextColumn Header="DETAILS" Binding="{Binding Details}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="Empty" Text="Nothing logged yet." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
