<Window x:Class="ExamBox.Admin.StudentHistoryDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="620" Height="460" Title="Exam history" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource PageBackgroundBrush}" FontFamily="Segoe UI">
    <Grid>
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="340" Height="340" Fill="{StaticResource OrbBlueBrush}" Canvas.Right="-120" Canvas.Top="-130"/>
            <Ellipse Width="300" Height="300" Fill="{StaticResource OrbPurpleBrush}" Canvas.Left="-110" Canvas.Bottom="-120"/>
        </Canvas>
        <Border Background="{StaticResource FrostBrush}" CornerRadius="16" Margin="12" BorderBrush="#B3FFFFFF" BorderThickness="1.5">

    <DockPanel Margin="26">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14"><Border Style="{StaticResource IconBadge}"><TextBlock Text="&#xE81C;" Style="{StaticResource IconGlyph}"/></Border><TextBlock x:Name="Heading" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" Style="{StaticResource PrimaryButton}" IsDefault="True" IsCancel="True" Margin="0"/>
        </StackPanel>
        <Grid>
            <DataGrid x:Name="Table">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="EXAM" Binding="{Binding Exam}" Width="2*"/>
                    <DataGridTextColumn Header="RESULT" Binding="{Binding Result}" Width="*"/>
                    <DataGridTextColumn Header="OUTCOME" Binding="{Binding Outcome}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="Empty" Text="No exams taken yet." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
        </Border>
    </Grid>
</Window>
