<Window UseLayoutRounding="True" SnapsToDevicePixels="True" x:Class="ExamBox.Admin.StudentDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource PageBackgroundBrush}" FontFamily="Segoe UI">
    <Grid>
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="340" Height="340" Fill="{StaticResource OrbBlueBrush}" Canvas.Right="-120" Canvas.Top="-130"/>
            <Ellipse Width="300" Height="300" Fill="{StaticResource OrbPurpleBrush}" Canvas.Left="-110" Canvas.Bottom="-120"/>
        </Canvas>
        <Border Background="{StaticResource FrostBrush}" CornerRadius="16" Margin="12" BorderBrush="#B3FFFFFF" BorderThickness="1.5">

    <StackPanel Margin="26">
        <StackPanel Orientation="Horizontal"><Border Style="{StaticResource IconBadge}"><TextBlock Text="&#xE77B;" Style="{StaticResource IconGlyph}"/></Border><TextBlock x:Name="Heading" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
        <TextBlock x:Name="Sub" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
        <TextBlock Text="Full name" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="FullName"/>
        <TextBlock Text="Student ID" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="StudentId"/>
        <TextBlock Text="Department / class (optional)" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="Department"/>
        <TextBlock Text="Email (optional)" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="Email"/>
        <CheckBox x:Name="Active" Content="Account active (can sign in)" IsChecked="True" Margin="0,16,0,0"/>
        <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True"/>
            <Button x:Name="SaveBtn" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" Margin="0"/>
        </StackPanel>
    </StackPanel>
        </Border>
    </Grid>
</Window>
