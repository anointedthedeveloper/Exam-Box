<Window UseLayoutRounding="True" SnapsToDevicePixels="True" x:Class="ExamBox.Admin.LaunchDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource PageBackgroundBrush}" FontFamily="Segoe UI">
    <Grid>
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="340" Height="340" Fill="{StaticResource OrbBlueBrush}" Canvas.Right="-120" Canvas.Top="-130"/>
            <Ellipse Width="300" Height="300" Fill="{StaticResource OrbPurpleBrush}" Canvas.Left="-110" Canvas.Bottom="-120"/>
        </Canvas>
        <Border Background="{StaticResource FrostBrush}" CornerRadius="16" Margin="12" BorderBrush="#B3FFFFFF" BorderThickness="1.5">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="760">
            <StackPanel Margin="26">
                <StackPanel Orientation="Horizontal"><Border Style="{StaticResource IconBadge}"><TextBlock Text="&#xE768;" Style="{StaticResource IconGlyph}"/></Border><TextBlock x:Name="Heading" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
                <TextBlock x:Name="Sub" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock Text="Who can take it" Style="{StaticResource FieldLabel}"/>
                <RadioButton x:Name="WhoAll" Content="Every student" IsChecked="True" GroupName="who" Margin="0,2,0,6" Checked="Who_Changed"/>
                <RadioButton x:Name="WhoClass" Content="Only one class" GroupName="who" Checked="Who_Changed"/>
                <ComboBox x:Name="ClassBox" IsEditable="True" Margin="22,8,0,0" IsEnabled="False"/>
                <TextBlock Text="Opens" Style="{StaticResource FieldLabel}"/>
                <RadioButton x:Name="OpenNow" Content="As soon as I launch it" IsChecked="True" GroupName="op" Margin="0,2,0,6" Checked="When_Changed"/>
                <RadioButton x:Name="OpenAt" Content="On a date and time" GroupName="op" Checked="When_Changed"/>
                <StackPanel x:Name="OpenRow" Orientation="Horizontal" Margin="22,8,0,0" IsEnabled="False">
                    <DatePicker x:Name="OpenDate" Width="160"/>
                    <TextBox x:Name="OpenTime" Width="80" Text="08:00" Margin="10,0,0,0" ToolTip="24-hour time, e.g. 08:00 or 14:30"/>
                </StackPanel>
                <TextBlock Text="Closes" Style="{StaticResource FieldLabel}"/>
                <RadioButton x:Name="CloseNever" Content="When I close it myself" IsChecked="True" GroupName="cl" Margin="0,2,0,6" Checked="When_Changed"/>
                <RadioButton x:Name="CloseAt" Content="On a date and time" GroupName="cl" Checked="When_Changed"/>
                <StackPanel x:Name="CloseRow" Orientation="Horizontal" Margin="22,8,0,0" IsEnabled="False">
                    <DatePicker x:Name="CloseDate" Width="160"/>
                    <TextBox x:Name="CloseTime" Width="80" Text="18:00" Margin="10,0,0,0" ToolTip="24-hour time, e.g. 08:00 or 14:30"/>
                </StackPanel>
                <TextBlock x:Name="Summary" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True"/>
                    <Button x:Name="SaveBtn" Content="Launch exam" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Launch_Click" Margin="0"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
