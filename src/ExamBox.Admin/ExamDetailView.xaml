<UserControl x:Class="ExamBox.Admin.ExamDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Button Content="← All exams" Style="{StaticResource GhostButton}" Click="Back_Click" HorizontalAlignment="Left" Padding="10,5" Margin="0,0,0,10"/>
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TitleText" Style="{StaticResource H1}"/>
                        <Border x:Name="StatePill" CornerRadius="10" Padding="11,3" Margin="14,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="{StaticResource OkBrush}" Margin="0,0,7,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <TextBlock x:Name="StateText" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="Meta" Style="{StaticResource Muted}"/>
                    <TextBlock x:Name="WindowInfo" Style="{StaticResource Muted}" FontSize="12"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="LaunchBtn" Style="{StaticResource PrimaryButton}" Click="Launch_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Launch" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="StopBtn" Style="{StaticResource DangerButton}" Click="Stop_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="Close now" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="TakeDownBtn" Style="{StaticResource GhostButton}" Click="TakeDown_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="Take off portal" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Content="Duplicate" Style="{StaticResource GhostButton}" Click="Duplicate_Click"/>
                    <Button Content="Edit details" Style="{StaticResource GhostButton}" Click="Edit_Click"/>
                    <Button Content="Delete" Style="{StaticResource DangerButton}" Click="Delete_Click" Margin="0"/>
                </StackPanel>
            </DockPanel>
            <Border x:Name="LockedNote" Background="{StaticResource WarnBgBrush}" CornerRadius="10" Padding="14,10" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock Foreground="{StaticResource WarnBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                           Text="Students have started this exam, so its questions are locked to keep grading consistent. Use Duplicate to make an editable copy."/>
            </Border>
            <Border x:Name="PicNote" Background="{StaticResource WarnBgBrush}" CornerRadius="10" Padding="14,10" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock x:Name="PicNoteText" Foreground="{StaticResource WarnBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
        <TabControl>
            <TabItem Header="Questions" Padding="14,8" FontSize="14">
                <DockPanel Margin="0,12,0,0">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button x:Name="AddQ" Style="{StaticResource PrimaryButton}" Click="AddQ_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Add question" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="ImportQ" Style="{StaticResource GhostButton}" Click="Import_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Import from Excel" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="TemplateQ" Style="{StaticResource GhostButton}" Click="Template_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Download template" VerticalAlignment="Center"/></StackPanel></Button>
                        <Border Width="1" Background="{StaticResource LineBrush}" Margin="4,4,12,4"/>
                        <Button x:Name="EditQ" Style="{StaticResource GhostButton}" Click="EditQ_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="Edit" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="PicQ" Style="{StaticResource GhostButton}" Click="Pic_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Attach picture" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="UpQ" Style="{StaticResource GhostButton}" Click="Up_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Move up" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="DownQ" Style="{StaticResource GhostButton}" Click="Down_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Move down" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="DelQ" Style="{StaticResource DangerButton}" Click="DelQ_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="Delete" VerticalAlignment="Center"/></StackPanel></Button>
                    </WrapPanel>
                    <TextBlock x:Name="QSummary" DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="4,10,0,0"/>
                    <Border Style="{StaticResource GridCard}">
                        <Grid>
                            <DataGrid x:Name="QTable" SelectionChanged="QTable_SelectionChanged" MouseDoubleClick="QTable_DoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NO." Binding="{Binding No}" Width="60"/>
                                    <DataGridTextColumn Header="TYPE" Binding="{Binding Kind}" Width="90"/>
                                    <DataGridTextColumn Header="QUESTION" Binding="{Binding Text}" Width="3*"/>
                                    <DataGridTextColumn Header="DETAILS" Binding="{Binding Details}" Width="2*"/>
                                    <DataGridTextColumn Header="MARKS" Binding="{Binding Marks}" Width="75"/>
                                    <DataGridTextColumn Header="PICTURE" Binding="{Binding Picture}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel x:Name="QEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,24">
                                <Border Style="{StaticResource IllustrationPanel}" Width="280" HorizontalAlignment="Center"><Image Source="/Assets/admin-exams.png"/></Border>
                                <TextBlock Text="No questions yet" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,16,0,4"/>
                                <TextBlock Text="Import a filled-in Excel sheet, or add questions one by one." Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                    <Button Content="Import from Excel" Style="{StaticResource PrimaryButton}" Click="Import_Click"/>
                                    <Button Content="Download template" Style="{StaticResource GhostButton}" Click="Template_Click" Margin="0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DockPanel>
            </TabItem>
            <TabItem Header="Results" Padding="14,8" FontSize="14">
                <DockPanel Margin="0,12,0,0">
                    <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,12,0,0">
                        <Button DockPanel.Dock="Left" x:Name="MarkBtn" Content="Mark selected" Style="{StaticResource PrimaryButton}" Click="Mark_Click"/>
                        <Button DockPanel.Dock="Left" Content="Export CSV" Style="{StaticResource GhostButton}" Click="Export_Click"/>
                        <TextBlock x:Name="ResultSummary" DockPanel.Dock="Left" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </DockPanel>
                    <Border Style="{StaticResource GridCard}">
                        <DataGrid x:Name="RTable" SelectionChanged="RTable_SelectionChanged" MouseDoubleClick="RTable_DoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STUDENT" Binding="{Binding Student}" Width="2*"/>
                                <DataGridTextColumn Header="STUDENT ID" Binding="{Binding StudentId}" Width="*"/>
                                <DataGridTextColumn Header="OBJECTIVE" Binding="{Binding Objective}" Width="95"/>
                                <DataGridTextColumn Header="THEORY" Binding="{Binding Theory}" Width="85"/>
                                <DataGridTextColumn Header="TOTAL" Binding="{Binding Score}" Width="100"/>
                                <DataGridTextColumn Header="PERCENT" Binding="{Binding Percent}" Width="90"/>
                                <DataGridTemplateColumn Header="OUTCOME" Width="120" SortMemberPath="Outcome" CellTemplate="{StaticResource OutcomeCell}"/>
                                <DataGridTextColumn Header="SUBMITTED" Binding="{Binding Submitted}" Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
