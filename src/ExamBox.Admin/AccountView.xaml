<UserControl x:Class="ExamBox.Admin.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="My account" Style="{StaticResource H1}"/>
            <TextBlock Text="Your profile, password and data." Style="{StaticResource Muted}" Margin="0,2,0,18"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <Border Width="84" Height="84" CornerRadius="42" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0847B8" Offset="0"/><GradientStop Color="#3D8BFF" Offset="1"/></LinearGradientBrush>
                            </Border.Background>
                            <TextBlock x:Name="Initial" FontSize="34" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="Who" FontSize="20" FontWeight="ExtraBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        <Border Background="{StaticResource BlueLightBrush}" CornerRadius="10" Padding="11,3" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <TextBlock Text="Administrator" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BlueDarkBrush}"/>
                        </Border>
                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,18,0,14"/>
                        <DockPanel Margin="0,0,0,8"><TextBlock x:Name="StatStudents" DockPanel.Dock="Right" FontWeight="Bold"/><TextBlock Text="Students" Style="{StaticResource Muted}"/></DockPanel>
                        <DockPanel Margin="0,0,0,8"><TextBlock x:Name="StatExams" DockPanel.Dock="Right" FontWeight="Bold"/><TextBlock Text="Exams" Style="{StaticResource Muted}"/></DockPanel>
                        <DockPanel Margin="0,0,0,8"><TextBlock x:Name="StatMarking" DockPanel.Dock="Right" FontWeight="Bold"/><TextBlock Text="Awaiting marking" Style="{StaticResource Muted}"/></DockPanel>
                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,10,0,14"/>
                        <TextBlock x:Name="LastIn" Style="{StaticResource Muted}" FontSize="12"/>
                        <TextBlock x:Name="Since" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource IconBadge}"><TextBlock Text="&#xE192;" Style="{StaticResource IconGlyph}"/></Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Change password" Style="{StaticResource H2}"/>
                                <TextBlock Text="Any non-empty password works; choose one you will remember." Style="{StaticResource Muted}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Current password" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="Current"/>
                        <TextBlock Text="New password" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="New"/>
                        <TextBlock Text="Confirm new password" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="Confirm"/>
                        <Border x:Name="ErrorBox" Background="{StaticResource ErrBgBrush}" CornerRadius="10" Padding="12,9" Margin="0,16,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Border>
                        <Button Content="Update password" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="0,20,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="4" VerticalAlignment="Top">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBadge}"><TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyph}"/></Border>
                                <TextBlock Text="Your data" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,14,0,10" TextWrapping="Wrap"
                                       Text="Everything lives in a database file on this computer. Back it up from Settings or by copying this folder."/>
                            <TextBox x:Name="DataPath" IsReadOnly="True"/>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="Open folder" Style="{StaticResource GhostButton}" Click="OpenFolder_Click"/>
                                <Button Content="Backup…" Style="{StaticResource GhostButton}" Click="Settings_Click" Margin="0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBadge}"><TextBlock Text="&#xE72E;" Style="{StaticResource IconGlyph}"/></Border>
                                <TextBlock Text="Session" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,14,0,12" TextWrapping="Wrap" Text="You sign in again every time ExamBox starts. Sign out now if you are leaving the computer."/>
                            <Button Content="Sign out" Style="{StaticResource DangerButton}" Click="SignOut_Click" HorizontalAlignment="Left" Margin="0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
