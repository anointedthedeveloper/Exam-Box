<UserControl x:Class="ExamBox.Admin.ServerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:ExamBox.Admin"
             xmlns:local="clr-namespace:ExamBox.Admin">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Student portal" Style="{StaticResource H1}"/>
            <TextBlock Text="Students sit exams in a web browser. ExamBox hosts that site for you, keep this app open while exams are running."
                       Style="{StaticResource Muted}" Margin="0,2,0,18"/>

            <Grid r:Responsive.StackBelow="1000">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource IllustrationPanel}" Width="260" Height="200" VerticalAlignment="Top" Margin="20,0,0,0">
                    <Image Source="/Assets/slide-devices.png"/>
                </Border>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="StatusPill" CornerRadius="16" Padding="14,6" Background="{StaticResource ErrBgBrush}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource ErrBrush}" VerticalAlignment="Center">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.9"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock x:Name="StatusText" FontSize="15" FontWeight="Bold" Margin="9,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <local:Spinner x:Name="Busy" Visibility="Collapsed" Margin="12,0,0,0" Width="18" Height="18"/>
                    </StackPanel>
                    <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Visibility="Collapsed" Margin="0,6,0,0"/>
                    <TextBlock x:Name="UrlHint" Text="Give students one of these addresses (they must be on the same network or Wi-Fi):" Style="{StaticResource Muted}" Margin="0,14,0,6"/>
                    <ListBox x:Name="Urls" ItemContainerStyle="{StaticResource UrlItem}" BorderThickness="0" Background="Transparent" MaxHeight="170" FontSize="15" FontWeight="SemiBold">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource BlueBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="CopyBtn" Content="Copy address" Style="{StaticResource GhostButton}" Click="Copy_Click"/>
                        <Button x:Name="OpenBtn" Content="Open in browser" Style="{StaticResource GhostButton}" Click="Open_Click"/>
                    </StackPanel>
                </StackPanel>
              </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Settings" Style="{StaticResource H2}"/>
                    <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="PortBox" Width="110"/>
                        <TextBlock Text="Default 5109. Change it only if another program uses that port." Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="AutoStart" Style="{StaticResource SwitchBox}" Content="Start the student portal automatically when ExamBox opens" Margin="0,18,0,0" Checked="Auto_Changed" Unchecked="Auto_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button x:Name="ToggleBtn" Style="{StaticResource PrimaryButton}" Click="Toggle_Click"/>
                        <Button x:Name="RestartBtn" Content="Apply port &amp; restart" Style="{StaticResource GhostButton}" Click="Restart_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource WarnBgBrush}" CornerRadius="10" Padding="14,10" Margin="0,16,0,0">
                <TextBlock Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"
                           Text="The first time the portal starts, Windows may ask to allow ExamBox through the firewall. Choose “Allow” (Private networks) so other computers can connect."/>
            </Border>
                </StackPanel>
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="How students join" Style="{StaticResource H2}"/>
                    <DockPanel Margin="0,14,0,0">
                        <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="16" Background="{StaticResource BlueLightBrush}" VerticalAlignment="Top"><TextBlock Text="1" FontWeight="ExtraBold" Foreground="{StaticResource BlueDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Margin="14,0,0,0"><TextBlock Text="Keep ExamBox open" FontWeight="SemiBold"/><TextBlock Text="The portal only runs while this app is running on this computer." Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"/></StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,14,0,0">
                        <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="16" Background="{StaticResource BlueLightBrush}" VerticalAlignment="Top"><TextBlock Text="2" FontWeight="ExtraBold" Foreground="{StaticResource BlueDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Margin="14,0,0,0"><TextBlock Text="Share the address" FontWeight="SemiBold"/><TextBlock Text="Students on the same Wi-Fi or network type it into any browser." Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"/></StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,14,0,0">
                        <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="16" Background="{StaticResource BlueLightBrush}" VerticalAlignment="Top"><TextBlock Text="3" FontWeight="ExtraBold" Foreground="{StaticResource BlueDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Margin="14,0,0,0"><TextBlock Text="They sign in with their Student ID" FontWeight="SemiBold"/><TextBlock Text="The password is the one you set for them on the Students page." Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"/></StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,14,0,0">
                        <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="16" Background="{StaticResource BlueLightBrush}" VerticalAlignment="Top"><TextBlock Text="4" FontWeight="ExtraBold" Foreground="{StaticResource BlueDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Margin="14,0,0,0"><TextBlock Text="Launch the exam" FontWeight="SemiBold"/><TextBlock Text="Under Exams, launch it for everyone or one class, now or at a set time." Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"/></StackPanel>
                    </DockPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Before exam day" Style="{StaticResource H2}"/>
                        <TextBlock Text="• Open the address on a student device to test it." Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="• Allow ExamBox through the Windows firewall (Private networks)." Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="• Plug the computer in and turn off sleep." Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="• Back up the database from Settings." Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
