<UserControl x:Class="ExamBox.Admin.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Settings" Style="{StaticResource H1}"/>
            <TextBlock Text="Make ExamBox yours. Changes apply straight away." Style="{StaticResource Muted}" Margin="0,2,0,18"/>

            <WrapPanel>
                <Border Style="{StaticResource Card}" Width="430" Margin="0,0,18,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource IconBadge}"><TextBlock Text="&#xE825;" Style="{StaticResource IconGlyph}"/></Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Institution" Style="{StaticResource H2}"/>
                                <TextBlock Text="Shown on the dashboard and on the student website" Style="{StaticResource Muted}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="InstitutionName" MaxLength="60"/>
                        <TextBlock Text="Leave empty to use “ExamBox”. If the student portal is running it restarts so the new name shows." Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Width="430" Margin="0,0,0,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource IconBadge}"><TextBlock Text="&#xE916;" Style="{StaticResource IconGlyph}"/></Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Exam defaults" Style="{StaticResource H2}"/>
                                <TextBlock Text="Pre-filled when you create a new exam" Style="{StaticResource Muted}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Duration (minutes)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="DefaultDuration"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Pass mark (%)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="DefaultPass"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                <Button Content="Save changes" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                <TextBlock x:Name="SavedText" Foreground="{StaticResource OkBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0" VerticalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>

            <WrapPanel>
                <Border Style="{StaticResource Card}" Width="430" Margin="0,0,18,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource IconBadge}"><TextBlock Text="&#xE774;" Style="{StaticResource IconGlyph}"/></Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Student portal" Style="{StaticResource H2}"/>
                                <TextBlock Text="The website students use to sit exams" Style="{StaticResource Muted}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Ellipse x:Name="PortalDot" Width="10" Height="10" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PortalText" Margin="9,0,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Content="Manage portal" Style="{StaticResource GhostButton}" Click="Portal_Click" Margin="0,16,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Width="430" Margin="0,0,0,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource IconBadge}"><TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyph}"/></Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Backup and data" Style="{StaticResource H2}"/>
                                <TextBlock Text="Everything is stored on this computer" Style="{StaticResource Muted}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBox x:Name="DataPath" IsReadOnly="True" Margin="0,14,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Click="Backup_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Back up database…" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                            <Button Content="Open folder" Style="{StaticResource GhostButton}" Click="OpenFolder_Click" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="A backup is a single file you can keep on a USB drive or cloud folder." Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Width="430" Margin="0,0,18,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource IconBadge}"><TextBlock Text="&#xE72E;" Style="{StaticResource IconGlyph}"/></Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Security" Style="{StaticResource H2}"/>
                                <TextBlock Text="How sign-in is protected" Style="{StaticResource Muted}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{StaticResource InkBrush}" LineHeight="21"
                                   Text="•  Passwords are stored hashed; no password is ever saved in plain text.&#10;•  After 10 wrong sign-in attempts an account is locked for 5 minutes.&#10;•  You sign in again every time ExamBox starts. With “Remember me”, the saved password is pre-filled (encrypted for your Windows account) but never signs you in by itself.&#10;•  Student sessions end when ExamBox restarts or after 2 hours idle.&#10;•  Forgot the admin password? Run ExamBox.exe --reset-admin NewPassword."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Width="430" Margin="0,0,0,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource IconBadge}"><TextBlock Text="&#xE946;" Style="{StaticResource IconGlyph}"/></Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="About" Style="{StaticResource H2}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="AboutText" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{StaticResource InkBrush}" LineHeight="21"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
