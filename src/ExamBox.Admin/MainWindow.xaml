<Window x:Class="ExamBox.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ExamBox" Width="1220" Height="780" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI" Icon="/Assets/logo.png">
    <Grid>
        <Grid x:Name="Shell" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="14,20">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Border BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0" Padding="6,14,6,0">
                            <StackPanel>
                                <TextBlock x:Name="UserName" Foreground="White" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Administrator" Foreground="#B9CBFF" FontSize="12"/>
                                <Button Content="Sign out" Click="SignOut_Click" Margin="0,10,0,0" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,22">
                            <Border Background="White" CornerRadius="10" Width="40" Height="40" Padding="2">
                                <Image Source="/Assets/logo.png"/>
                            </Border>
                            <TextBlock Text="ExamBox" Foreground="White" FontSize="21" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <RadioButton x:Name="NavDashboard" Content="Dashboard" Tag="dashboard" GroupName="nav" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                        <RadioButton x:Name="NavStudents" Content="Students" Tag="students" GroupName="nav" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                        <RadioButton x:Name="NavExams" Content="Exams" Tag="exams" GroupName="nav" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                        <RadioButton x:Name="NavServer" Content="Student portal" Tag="server" GroupName="nav" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                        <RadioButton x:Name="NavAccount" Content="My account" Tag="account" GroupName="nav" Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ContentControl x:Name="Page" Grid.Column="1" Margin="30,26,30,20"/>
        </Grid>
        <ContentControl x:Name="AuthHost"/>
    </Grid>
</Window>
