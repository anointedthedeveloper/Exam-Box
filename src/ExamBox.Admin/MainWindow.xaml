<Window UseLayoutRounding="True" SnapsToDevicePixels="True" x:Class="ExamBox.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ExamBox" Width="1220" Height="780" MinWidth="900" MinHeight="620"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI" Icon="/Assets/logo.ico">
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="OrbA" Storyboard.TargetProperty="X" From="0" To="-70" Duration="0:0:13" AccelerationRatio="0.4" DecelerationRatio="0.4"/>
                    <DoubleAnimation Storyboard.TargetName="OrbA" Storyboard.TargetProperty="Y" From="0" To="60" Duration="0:0:13" AccelerationRatio="0.4" DecelerationRatio="0.4"/>
                    <DoubleAnimation Storyboard.TargetName="OrbB" Storyboard.TargetProperty="X" From="0" To="80" Duration="0:0:16" AccelerationRatio="0.4" DecelerationRatio="0.4"/>
                    <DoubleAnimation Storyboard.TargetName="OrbB" Storyboard.TargetProperty="Y" From="0" To="-70" Duration="0:0:16" AccelerationRatio="0.4" DecelerationRatio="0.4"/>
                    <DoubleAnimation Storyboard.TargetName="OrbC" Storyboard.TargetProperty="X" From="0" To="-90" Duration="0:0:11" AccelerationRatio="0.4" DecelerationRatio="0.4"/>
                    <DoubleAnimation Storyboard.TargetName="OrbC" Storyboard.TargetProperty="Y" From="0" To="-40" Duration="0:0:11" AccelerationRatio="0.4" DecelerationRatio="0.4"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Grid>
        <Grid x:Name="Shell" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- soft gradient page with drifting orbs behind everything -->
            <Grid Grid.RowSpan="2" Background="{StaticResource PageBackgroundBrush}" ClipToBounds="True">
                <Ellipse Width="760" Height="760" Fill="{StaticResource OrbBlueBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-300,-260,0" IsHitTestVisible="False">
                    <Ellipse.RenderTransform><TranslateTransform x:Name="OrbA"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="620" Height="620" Fill="{StaticResource OrbPurpleBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-220,0,0,-260" IsHitTestVisible="False">
                    <Ellipse.RenderTransform><TranslateTransform x:Name="OrbB"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="480" Height="480" Fill="{StaticResource OrbTealBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,140,-210" IsHitTestVisible="False">
                    <Ellipse.RenderTransform><TranslateTransform x:Name="OrbC"/></Ellipse.RenderTransform>
                </Ellipse>
            </Grid>

            <ContentControl x:Name="Page" Grid.Row="1" Margin="18,18,18,16"/>

            <!-- navbar: a blue strip that continues the title bar, with rounded bottom corners -->
            <Border x:Name="TopBar" Grid.Row="0" Margin="18,12,18,0" CornerRadius="26" Padding="20,9,20,9" BorderBrush="#40FFFFFF" BorderThickness="1" Effect="{StaticResource SoftShadow}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0847B8" Offset="0"/>
                        <GradientStop Color="#0A4FCB" Offset="0.55"/>
                        <GradientStop Color="#1565F0" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource LogoBadge}" Width="42" Height="42" CornerRadius="13" Padding="8">
                            <Image Source="/Assets/logo.png"/>
                        </Border>
                        <StackPanel x:Name="BrandText" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="BrandName" Text="ExamBox" Foreground="White" FontSize="19" FontWeight="ExtraBold" MaxWidth="190" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="ADMIN" Foreground="#9FB8F0" FontSize="10.5" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>

                    <Border x:Name="NavCapsule" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#1FFFFFFF" BorderBrush="#47FFFFFF" BorderThickness="1" CornerRadius="26" Padding="5">
                        <Grid>
                            <Border x:Name="NavPill" Background="White" CornerRadius="21" HorizontalAlignment="Left" Width="0" Opacity="0" IsHitTestVisible="False" Effect="{StaticResource CardShadow}">
                                <Border.RenderTransform><TranslateTransform x:Name="PillMove"/></Border.RenderTransform>
                            </Border>
                            <StackPanel x:Name="NavItems" Orientation="Horizontal">
                            <RadioButton x:Name="NavDashboard" Tag="dashboard" GroupName="nav" ToolTip="Dashboard" Style="{StaticResource TopNavButton}" Click="Nav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/><TextBlock Text="Dashboard" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></RadioButton>
                            <Grid>
                                <RadioButton x:Name="NavStudents" Tag="students" GroupName="nav" Style="{StaticResource TopNavButton}" Click="Nav_Click" MouseEnter="Group_Enter" MouseLeave="Group_Leave"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/><TextBlock Text="Students" Margin="9,0,0,0" VerticalAlignment="Center"/><TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="8,1,0,0" VerticalAlignment="Center" Opacity="0.7"/></StackPanel></RadioButton>
                                <Popup x:Name="PopStudents" PlacementTarget="{Binding ElementName=NavStudents}" Placement="Bottom" VerticalOffset="6" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Width="236" Background="White" CornerRadius="16" Padding="8" Margin="10,6,10,18" BorderBrush="#E3E8F3" BorderThickness="1" MouseEnter="Pop_Enter" MouseLeave="Pop_Leave">
                                        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.22" Color="#0F2A6B"/></Border.Effect>
                                        <StackPanel>
                                    <Button Style="{StaticResource MenuRow}" Tag="students" Click="Menu_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource BlueBrush}" Width="26" VerticalAlignment="Center"/><TextBlock Text="Students" VerticalAlignment="Center"/></StackPanel></Button>
                                    <Button Style="{StaticResource MenuRow}" Tag="classes" Click="Menu_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource BlueBrush}" Width="26" VerticalAlignment="Center"/><TextBlock Text="Classes" VerticalAlignment="Center"/></StackPanel></Button>
                                    <Button Style="{StaticResource MenuRow}" Tag="online" Click="Menu_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource BlueBrush}" Width="26" VerticalAlignment="Center"/><TextBlock Text="Online now" VerticalAlignment="Center"/></StackPanel></Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <Grid>
                                <RadioButton x:Name="NavExams" Tag="exams" GroupName="nav" Style="{StaticResource TopNavButton}" Click="Nav_Click" MouseEnter="Group_Enter" MouseLeave="Group_Leave"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/><TextBlock Text="Exams" Margin="9,0,0,0" VerticalAlignment="Center"/><Border x:Name="MarkingBadge" Background="#F2A900" CornerRadius="8" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock x:Name="MarkingBadgeText" FontSize="10" FontWeight="Bold" Foreground="#3B2A00"/></Border><TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="8,1,0,0" VerticalAlignment="Center" Opacity="0.7"/></StackPanel></RadioButton>
                                <Popup x:Name="PopExams" PlacementTarget="{Binding ElementName=NavExams}" Placement="Bottom" VerticalOffset="6" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Width="236" Background="White" CornerRadius="16" Padding="8" Margin="10,6,10,18" BorderBrush="#E3E8F3" BorderThickness="1" MouseEnter="Pop_Enter" MouseLeave="Pop_Leave">
                                        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.22" Color="#0F2A6B"/></Border.Effect>
                                        <StackPanel>
                                    <Button Style="{StaticResource MenuRow}" Tag="exams" Click="Menu_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource BlueBrush}" Width="26" VerticalAlignment="Center"/><TextBlock Text="Exams" VerticalAlignment="Center"/></StackPanel></Button>
                                    <Button Style="{StaticResource MenuRow}" Tag="marking" Click="Menu_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource BlueBrush}" Width="26" VerticalAlignment="Center"/><TextBlock Text="Marking" VerticalAlignment="Center"/><Border x:Name="MarkingBadge2" Background="#F2A900" CornerRadius="8" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock x:Name="MarkingBadgeText2" FontSize="10" FontWeight="Bold" Foreground="#3B2A00"/></Border></StackPanel></Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <Grid>
                                <RadioButton x:Name="NavReports" Tag="reports" GroupName="nav" Style="{StaticResource TopNavButton}" Click="Nav_Click" MouseEnter="Group_Enter" MouseLeave="Group_Leave"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/><TextBlock Text="Reports" Margin="9,0,0,0" VerticalAlignment="Center"/><Border x:Name="ReportsBadge" Background="#2FD6A2" CornerRadius="8" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock Text="new" FontSize="10" FontWeight="Bold" Foreground="#073B2A"/></Border><TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="8,1,0,0" VerticalAlignment="Center" Opacity="0.7"/></StackPanel></RadioButton>
                                <Popup x:Name="PopReports" PlacementTarget="{Binding ElementName=NavReports}" Placement="Bottom" VerticalOffset="6" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Width="236" Background="White" CornerRadius="16" Padding="8" Margin="10,6,10,18" BorderBrush="#E3E8F3" BorderThickness="1" MouseEnter="Pop_Enter" MouseLeave="Pop_Leave">
                                        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.22" Color="#0F2A6B"/></Border.Effect>
                                        <StackPanel>
                                    <Button Style="{StaticResource MenuRow}" Tag="reports" Click="Menu_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource BlueBrush}" Width="26" VerticalAlignment="Center"/><TextBlock Text="Reports" VerticalAlignment="Center"/></StackPanel></Button>
                                    <Button Style="{StaticResource MenuRow}" Tag="activity" Click="Menu_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource BlueBrush}" Width="26" VerticalAlignment="Center"/><TextBlock Text="Activity log" VerticalAlignment="Center"/></StackPanel></Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <Grid>
                                <RadioButton x:Name="NavSettings" Tag="settings" GroupName="nav" Style="{StaticResource TopNavButton}" Click="Nav_Click" MouseEnter="Group_Enter" MouseLeave="Group_Leave"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/><TextBlock Text="Settings" Margin="9,0,0,0" VerticalAlignment="Center"/><Border x:Name="SettingsBadge" Background="#2FD6A2" CornerRadius="8" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock Text="new" FontSize="10" FontWeight="Bold" Foreground="#073B2A"/></Border><TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="8,1,0,0" VerticalAlignment="Center" Opacity="0.7"/></StackPanel></RadioButton>
                                <Popup x:Name="PopSettings" PlacementTarget="{Binding ElementName=NavSettings}" Placement="Bottom" VerticalOffset="6" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Width="236" Background="White" CornerRadius="16" Padding="8" Margin="10,6,10,18" BorderBrush="#E3E8F3" BorderThickness="1" MouseEnter="Pop_Enter" MouseLeave="Pop_Leave">
                                        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.22" Color="#0F2A6B"/></Border.Effect>
                                        <StackPanel>
                                    <Button Style="{StaticResource MenuRow}" Tag="settings" Click="Menu_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource BlueBrush}" Width="26" VerticalAlignment="Center"/><TextBlock Text="Settings" VerticalAlignment="Center"/></StackPanel></Button>
                                    <Button Style="{StaticResource MenuRow}" Tag="server" Click="Menu_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource BlueBrush}" Width="26" VerticalAlignment="Center"/><TextBlock Text="Student portal" VerticalAlignment="Center"/><Ellipse x:Name="PortalDot" Width="8" Height="8" Margin="10,0,0,0" VerticalAlignment="Center" Fill="#E5484D" Stroke="White" StrokeThickness="1.5"/></StackPanel></Button>
                                    <Button Style="{StaticResource MenuRow}" Tag="account" Click="Menu_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource BlueBrush}" Width="26" VerticalAlignment="Center"/><TextBlock Text="My account" VerticalAlignment="Center"/></StackPanel></Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
</StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="ProfileChip" Grid.Column="2" Background="#1FFFFFFF" BorderBrush="#47FFFFFF" BorderThickness="1" CornerRadius="26" Padding="5,5,14,5" Cursor="Hand" VerticalAlignment="Center" MouseLeftButtonUp="Profile_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="18" Background="White">
                                <TextBlock x:Name="UserInitial" FontWeight="ExtraBold" FontSize="15" Foreground="{StaticResource BlueDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel x:Name="ProfileText" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="UserName" Foreground="White" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                                <TextBlock Text="Administrator" Foreground="#B9CBFF" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#C9D8FF" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <Popup x:Name="ProfilePopup" PlacementTarget="{Binding ElementName=ProfileChip}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="250" Background="White" CornerRadius="16" Padding="8" Margin="10,8,10,18" BorderBrush="#E3E8F3" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.22" Color="#0F2A6B"/></Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="10,8,10,10">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource BlueLightBrush}">
                                        <TextBlock x:Name="MenuInitial" FontWeight="ExtraBold" FontSize="16" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="MenuName" FontWeight="Bold" Foreground="{StaticResource InkBrush}" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Administrator" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Height="1" Background="{StaticResource LineBrush}" Margin="4,0,4,6"/>
                                <Button Style="{StaticResource MenuRow}" Click="MyAccount_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource BlueBrush}" Width="26" VerticalAlignment="Center"/><TextBlock Text="My account"/></StackPanel></Button>
                                <Button Style="{StaticResource MenuRow}" Click="SignOut_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource ErrBrush}" Width="26" VerticalAlignment="Center"/><TextBlock Text="Sign out" Foreground="{StaticResource ErrBrush}"/></StackPanel></Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
        </Grid>
        <ContentControl x:Name="AuthHost"/>
    </Grid>
</Window>
