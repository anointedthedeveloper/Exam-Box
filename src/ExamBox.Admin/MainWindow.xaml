<Window UseLayoutRounding="True" SnapsToDevicePixels="True" x:Class="ExamBox.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ExamBox" Width="1220" Height="780" MinWidth="960" MinHeight="620"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI" Icon="/Assets/logo.ico">
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="OrbA" Storyboard.TargetProperty="X" From="0" To="-70" Duration="0:0:13" AccelerationRatio="0.4" DecelerationRatio="0.4"/>
                    <DoubleAnimation Storyboard.TargetName="OrbA" Storyboard.TargetProperty="Y" From="0" To="60" Duration="0:0:13" AccelerationRatio="0.4" DecelerationRatio="0.4"/>
                    <DoubleAnimation Storyboard.TargetName="OrbB" Storyboard.TargetProperty="X" From="0" To="80" Duration="0:0:16" AccelerationRatio="0.4" DecelerationRatio="0.4"/>
                    <DoubleAnimation Storyboard.TargetName="OrbB" Storyboard.TargetProperty="Y" From="0" To="-70" Duration="0:0:16" AccelerationRatio="0.4" DecelerationRatio="0.4"/>
                    <DoubleAnimation Storyboard.TargetName="OrbC" Storyboard.TargetProperty="X" From="0" To="-90" Duration="0:0:11" AccelerationRatio="0.4" DecelerationRatio="0.4"/>
                    <DoubleAnimation Storyboard.TargetName="OrbC" Storyboard.TargetProperty="Y" From="0" To="-40" Duration="0:0:11" AccelerationRatio="0.4" DecelerationRatio="0.4"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Grid>
        <Grid x:Name="Shell" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="14,20">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Border Background="#1FFFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="14" Padding="14,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="38" Height="38" CornerRadius="19" Background="White">
                                        <TextBlock x:Name="UserInitial" FontWeight="ExtraBold" FontSize="16" Foreground="{StaticResource BlueDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="UserName" Foreground="White" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                        <TextBlock Text="Administrator" Foreground="#B9CBFF" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Content="Sign out" Click="SignOut_Click" Margin="0,12,0,0" Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch" Padding="12,7"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,22">
                            <Border Style="{StaticResource LogoBadge}" Width="46" Height="46" CornerRadius="13" Padding="8">
                                <Image Source="/Assets/logo.png"/>
                            </Border>
                            <TextBlock Text="ExamBox" Foreground="White" FontSize="21" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="MENU" Foreground="#8FB0F5" FontSize="11" FontWeight="Bold" Margin="14,0,0,8"/>
                        <RadioButton x:Name="NavDashboard" Tag="dashboard" GroupName="nav" Style="{StaticResource NavButton}" Click="Nav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" VerticalAlignment="Center"/><TextBlock Text="Dashboard" VerticalAlignment="Center"/></StackPanel></RadioButton>
                        <RadioButton x:Name="NavStudents" Tag="students" GroupName="nav" Style="{StaticResource NavButton}" Click="Nav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" VerticalAlignment="Center"/><TextBlock Text="Students" VerticalAlignment="Center"/></StackPanel></RadioButton>
                        <RadioButton x:Name="NavExams" Tag="exams" GroupName="nav" Style="{StaticResource NavButton}" Click="Nav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" VerticalAlignment="Center"/><TextBlock Text="Exams" VerticalAlignment="Center"/></StackPanel></RadioButton>
                        <RadioButton x:Name="NavServer" Tag="server" GroupName="nav" Style="{StaticResource NavButton}" Click="Nav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" VerticalAlignment="Center"/><TextBlock Text="Student portal" VerticalAlignment="Center"/></StackPanel></RadioButton>
                        <RadioButton x:Name="NavAccount" Tag="account" GroupName="nav" Style="{StaticResource NavButton}" Click="Nav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" VerticalAlignment="Center"/><TextBlock Text="My account" VerticalAlignment="Center"/></StackPanel></RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Background="{StaticResource PageBackgroundBrush}" ClipToBounds="True">
                <Ellipse Width="760" Height="760" Fill="{StaticResource OrbBlueBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-300,-260,0" IsHitTestVisible="False">
                    <Ellipse.RenderTransform><TranslateTransform x:Name="OrbA"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="620" Height="620" Fill="{StaticResource OrbPurpleBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-220,0,0,-260" IsHitTestVisible="False">
                    <Ellipse.RenderTransform><TranslateTransform x:Name="OrbB"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="480" Height="480" Fill="{StaticResource OrbTealBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,140,-210" IsHitTestVisible="False">
                    <Ellipse.RenderTransform><TranslateTransform x:Name="OrbC"/></Ellipse.RenderTransform>
                </Ellipse>
                <ContentControl x:Name="Page" Margin="30,26,30,20"/>
            </Grid>
        </Grid>
        <ContentControl x:Name="AuthHost"/>
    </Grid>
</Window>
