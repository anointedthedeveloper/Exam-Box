<Window UseLayoutRounding="True" SnapsToDevicePixels="True" x:Class="ExamBox.Admin.TempPasswordDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="480" Title="Temporary password" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource PageBackgroundBrush}" FontFamily="Segoe UI">
    <Grid>
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="340" Height="340" Fill="{StaticResource OrbBlueBrush}" Canvas.Right="-120" Canvas.Top="-130"/>
            <Ellipse Width="300" Height="300" Fill="{StaticResource OrbPurpleBrush}" Canvas.Left="-110" Canvas.Bottom="-120"/>
        </Canvas>
        <Border Background="{StaticResource FrostBrush}" CornerRadius="16" Margin="12" BorderBrush="#B3FFFFFF" BorderThickness="1.5">

    <StackPanel Margin="26">
        <StackPanel Orientation="Horizontal"><Border Style="{StaticResource IconBadge}"><TextBlock Text="&#xE192;" Style="{StaticResource IconGlyph}"/></Border><TextBlock x:Name="Heading" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
        <TextBlock x:Name="Sub" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
        <Border Background="{StaticResource WarnBgBrush}" CornerRadius="10" Padding="14" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Temporary password (shown only once)" Foreground="{StaticResource WarnBrush}" FontWeight="SemiBold"/>
                <TextBox x:Name="Pass" IsReadOnly="True" FontFamily="Consolas" FontSize="22" Margin="0,8,0,0" TextAlignment="Center"/>
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CopyBtn" Content="Copy" Style="{StaticResource GhostButton}" Click="Copy_Click"/>
            <Button Content="Done" Style="{StaticResource PrimaryButton}" IsDefault="True" IsCancel="True" Margin="0"/>
        </StackPanel>
    </StackPanel>
        </Border>
    </Grid>
</Window>
