<Window x:Class="ExamBox.Admin.ExamDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="500" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BgBrush}" FontFamily="Segoe UI">
    <StackPanel Margin="26">
        <StackPanel Orientation="Horizontal"><Border Style="{StaticResource IconBadge}"><TextBlock Text="&#xE8A5;" Style="{StaticResource IconGlyph}"/></Border><TextBlock x:Name="Heading" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
        <TextBlock Text="Title" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="ExamTitle"/>
        <TextBlock Text="Instructions / description (optional)" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="Description" Style="{StaticResource MultiLineTextBox}" Height="90"/>
        <Grid Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Duration (minutes)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="Duration" Text="30"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Pass mark (%)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="PassMark" Text="50"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True"/>
            <Button x:Name="SaveBtn" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
