<UserControl x:Class="ExamBox.Admin.ExamsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel LastChildFill="False" Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Exams" Style="{StaticResource H1}"/>
                    <TextBlock Text="Build an exam once, keep it as a template, and launch it whenever it is needed." Style="{StaticResource Muted}"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="New_Click" Margin="0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="New exam" VerticalAlignment="Center"/></StackPanel></Button>
            </DockPanel>

            <UniformGrid Rows="1">
                <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,12,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12" Background="#3D8BFF" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatTotal" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="All exams" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,12,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12" Background="#19B58A" VerticalAlignment="Center">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatLive" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="Live now" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,12,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12" Background="#F2A900" VerticalAlignment="Center">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatDrafts" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="Drafts and templates" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,13" Margin="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12" Background="#8B5CF6" VerticalAlignment="Center">
                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatScheduled" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="Scheduled" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <DockPanel Margin="0,18,0,12">
                <TextBlock x:Name="Count" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <Grid Width="280" Margin="0,0,14,0">
                        <TextBox x:Name="Search" Padding="40,9,12,9" TextChanged="Search_Changed"/>
                        <TextBlock Text="&#xE721;" Style="{StaticResource IconGlyph}" FontSize="15" Foreground="#8B97B5" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock x:Name="SearchHint" Text="Search exams" Foreground="#A3AECA" VerticalAlignment="Center" Margin="41,0,0,0" IsHitTestVisible="False"/>
                    </Grid>
                    <Border Background="#1A305AB4" CornerRadius="10" Padding="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="FAll" Content="All" GroupName="ef" IsChecked="True" Style="{StaticResource SegmentButton}" Click="Filter_Click"/>
                            <RadioButton x:Name="FDraft" Content="Drafts" GroupName="ef" Style="{StaticResource SegmentButton}" Click="Filter_Click"/>
                            <RadioButton x:Name="FScheduled" Content="Scheduled" GroupName="ef" Style="{StaticResource SegmentButton}" Click="Filter_Click"/>
                            <RadioButton x:Name="FLive" Content="Live" GroupName="ef" Style="{StaticResource SegmentButton}" Click="Filter_Click"/>
                            <RadioButton x:Name="FClosed" Content="Closed" GroupName="ef" Style="{StaticResource SegmentButton}" Click="Filter_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>

            <Border x:Name="TableCard" Style="{StaticResource GridCard}">
                <Grid>
                    <DataGrid x:Name="Table" RowHeight="64" VerticalAlignment="Top" MouseDoubleClick="Grid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="EXAM" Width="2.4*" SortMemberPath="Title">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource BlueLightBrush}">
                                                <TextBlock Text="&#xE8A5;" Style="{StaticResource IconGlyph}" FontSize="16"/>
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Kind}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="QUESTIONS" Binding="{Binding Questions}" Width="100"/>
                            <DataGridTextColumn Header="DURATION" Binding="{Binding Duration}" Width="95"/>
                            <DataGridTextColumn Header="FOR" Binding="{Binding Audience}" Width="*"/>
                            <DataGridTextColumn Header="AVAILABLE" Binding="{Binding Window}" Width="1.6*"/>
                            <DataGridTextColumn Header="DONE" Binding="{Binding Submissions}" Width="70"/>
                            <DataGridTemplateColumn Header="STATUS" Width="110" SortMemberPath="Status" CellTemplate="{StaticResource StatusCell}"/>
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="&#xE8A7;" ToolTip="Open exam" Style="{StaticResource IconButtonBlue}" Click="Open_Click"/>
                                            <Button Content="&#xE768;" ToolTip="Launch for students" Style="{StaticResource IconButton}" Click="Launch_Click"/>
                                            <Button Content="&#xE8C8;" ToolTip="Duplicate as a new draft" Style="{StaticResource IconButton}" Click="Duplicate_Click"/>
                                            <Button Content="&#xE74D;" ToolTip="Delete exam" Style="{StaticResource IconButtonDanger}" Click="Delete_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,30">
                        <Border Style="{StaticResource IllustrationPanel}" Width="320" HorizontalAlignment="Center"><Image Source="/Assets/admin-exams.png"/></Border>
                        <TextBlock x:Name="EmptyTitle" Text="No exams yet" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,18,0,4"/>
                        <TextBlock x:Name="EmptyText" Text="Click “New exam”, then import your questions from Excel." Style="{StaticResource Muted}" TextAlignment="Center" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Text="Tip: a draft is a template. Use Duplicate to reuse it for another class or term, and Launch when it is time for students to sit it." Style="{StaticResource Muted}" FontSize="12" Margin="4,12,0,8"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
