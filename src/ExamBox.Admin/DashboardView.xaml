<UserControl x:Class="ExamBox.Admin.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border x:Name="HeroBanner" Background="{StaticResource HeroBrush}" CornerRadius="18" Padding="32,26" ClipToBounds="True" Effect="{StaticResource SoftShadow}">
                <Grid>
                    <Ellipse Width="360" Height="360" Fill="White" Opacity="0.07" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-190,-90,0"/>
                    <Ellipse Width="220" Height="220" Fill="White" Opacity="0.05" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="260,0,0,-130"/>
                    <DockPanel>
                        <Image DockPanel.Dock="Right" Source="/Assets/admin-analytics.png" Height="170" Margin="0,-14,10,-18"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="Greeting" FontSize="30" FontWeight="ExtraBold" Foreground="White"/>
                            <TextBlock x:Name="DateText" Foreground="#DBE6FF" FontSize="14" Margin="0,4,0,18"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Add student" Style="{StaticResource LightButton}" Click="AddStudent_Click"/>
                                <Button Content="New exam" Style="{StaticResource LightButton}" Click="NewExam_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <Border x:Name="PortalBanner" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="16,12"/>

            <Border x:Name="Checklist" Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock x:Name="ChecklistProgress" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource IconBadge}"><TextBlock Text="&#xE7C1;" Style="{StaticResource IconGlyph}"/></Border>
                            <TextBlock Text="Getting started" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel x:Name="ChecklistSteps"/>
                </StackPanel>
            </Border>

            <UniformGrid Rows="1" Margin="0,16,0,0">
                <Border x:Name="Stat0" Style="{StaticResource Card}" Margin="0,0,8,0"><DockPanel><Border DockPanel.Dock="Right" Width="42" Height="42" CornerRadius="11" Background="{StaticResource BlueLightBrush}" VerticalAlignment="Top"><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel>
                    <TextBlock x:Name="StudentsN" Style="{StaticResource StatNumber}"/>
                    <TextBlock Text="Students" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="StudentsSub" FontSize="12" Foreground="{StaticResource MutedBrush}"/></StackPanel></DockPanel></Border>
                <Border x:Name="Stat1" Style="{StaticResource Card}" Margin="8,0"><DockPanel><Border DockPanel.Dock="Right" Width="42" Height="42" CornerRadius="11" Background="{StaticResource BlueLightBrush}" VerticalAlignment="Top"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel>
                    <TextBlock x:Name="ExamsN" Style="{StaticResource StatNumber}"/>
                    <TextBlock Text="Exams" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="ExamsSub" FontSize="12" Foreground="{StaticResource MutedBrush}"/></StackPanel></DockPanel></Border>
                <Border x:Name="Stat2" Style="{StaticResource Card}" Margin="8,0"><DockPanel><Border DockPanel.Dock="Right" Width="42" Height="42" CornerRadius="11" Background="{StaticResource BlueLightBrush}" VerticalAlignment="Top"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel>
                    <TextBlock x:Name="DoneN" Style="{StaticResource StatNumber}"/>
                    <TextBlock Text="Completed attempts" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="DoneSub" FontSize="12" Foreground="{StaticResource MutedBrush}"/></StackPanel></DockPanel></Border>
                <Border x:Name="Stat3" Style="{StaticResource Card}" Margin="8,0,0,0"><DockPanel><Border DockPanel.Dock="Right" Width="42" Height="42" CornerRadius="11" Background="{StaticResource BlueLightBrush}" VerticalAlignment="Top"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel>
                    <TextBlock x:Name="AvgN" Style="{StaticResource StatNumber}"/>
                    <TextBlock Text="Average score" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="across submitted exams" FontSize="12" Foreground="{StaticResource MutedBrush}"/></StackPanel></DockPanel></Border>
            </UniformGrid>

            <Grid x:Name="Lists" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Recent submissions" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <Border Style="{StaticResource GridCard}" Height="330">
                        <Grid>
                            <DataGrid x:Name="RecentGrid" RowHeight="50">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="STUDENT" Binding="{Binding Student}" Width="1.4*"/>
                                    <DataGridTextColumn Header="EXAM" Binding="{Binding Exam}" Width="1.4*"/>
                                    <DataGridTextColumn Header="SCORE" Binding="{Binding Score}" Width="Auto"/>
                                    <DataGridTemplateColumn Header="RESULT" Width="Auto" CellTemplate="{StaticResource OutcomeCell}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel x:Name="RecentEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <Border Style="{StaticResource IconBadge}" Width="56" Height="56" CornerRadius="16" HorizontalAlignment="Center"><TextBlock Text="&#xE9D2;" Style="{StaticResource IconGlyph}" FontSize="24"/></Border>
                                <TextBlock Text="No submissions yet" Style="{StaticResource H2}" FontSize="16" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                                <TextBlock Text="Results show up here as students finish exams." Style="{StaticResource Muted}" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Newest students" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <Border Style="{StaticResource GridCard}" Height="330">
                        <Grid>
                            <DataGrid x:Name="NewGrid" RowHeight="54">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="STUDENT" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource BlueLightBrush}">
                                                        <TextBlock Text="{Binding Initial}" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Department}" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="STUDENT ID" Binding="{Binding StudentId}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel x:Name="NewEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <Border Style="{StaticResource IconBadge}" Width="56" Height="56" CornerRadius="16" HorizontalAlignment="Center"><TextBlock Text="&#xE716;" Style="{StaticResource IconGlyph}" FontSize="24"/></Border>
                                <TextBlock Text="No students yet" Style="{StaticResource H2}" FontSize="16" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                                <TextBlock Text="Add your first student to get started." Style="{StaticResource Muted}" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
