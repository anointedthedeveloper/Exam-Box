<UserControl x:Class="ExamBox.Admin.StudentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Students" Style="{StaticResource H1}"/>
                <TextBlock x:Name="Count" Style="{StaticResource Muted}"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="Search" Width="240" Margin="0,0,10,0" ToolTip="Search name, ID or email" TextChanged="Search_Changed"/>
                <Button Content="Add student" Style="{StaticResource PrimaryButton}" Click="Add_Click" Margin="0"/>
            </StackPanel>
        </DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="EditBtn" Content="Edit" Style="{StaticResource GhostButton}" Click="Edit_Click"/>
            <Button x:Name="HistoryBtn" Content="Exam history" Style="{StaticResource GhostButton}" Click="History_Click"/>
            <Button x:Name="ResetBtn" Content="Reset password" Style="{StaticResource GhostButton}" Click="Reset_Click"/>
            <Button x:Name="DeleteBtn" Content="Delete" Style="{StaticResource DangerButton}" Click="Delete_Click"/>
            <TextBlock Text="Select a student, then choose an action." Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>
        <Grid>
            <DataGrid x:Name="Table" SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Grid_DoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="STUDENT ID" Binding="{Binding StudentId}" Width="*"/>
                    <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="*"/>
                    <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="1.5*"/>
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="90"/>
                    <DataGridTextColumn Header="EXAMS" Binding="{Binding Exams}" Width="70"/>
                    <DataGridTextColumn Header="LAST LOGIN" Binding="{Binding LastLogin}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <Border Style="{StaticResource IllustrationPanel}" Width="320" HorizontalAlignment="Center"><Image Source="/Assets/slide-devices.png"/></Border>
                <TextBlock x:Name="EmptyTitle" Text="No students yet" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,18,0,4"/>
                <TextBlock x:Name="EmptyText" Text="Click “Add student” to create the first one." Style="{StaticResource Muted}" TextAlignment="Center" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
