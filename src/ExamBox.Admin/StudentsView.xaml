<UserControl x:Class="ExamBox.Admin.StudentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:ExamBox.Admin">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel LastChildFill="False" Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Students" Style="{StaticResource H1}"/>
                    <TextBlock Text="Create accounts, reset passwords and follow each student's progress." Style="{StaticResource Muted}"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="Add_Click" Margin="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Add student" VerticalAlignment="Center"/></StackPanel>
                </Button>
                <Button x:Name="MoreBtn" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="More_Click" VerticalAlignment="Center" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="More" VerticalAlignment="Center"/></StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Import students from Excel" Click="Import_Click"/>
                            <MenuItem Header="Download student template" Click="Template_Click"/>
                            <Separator/>
                            <MenuItem Header="Sign out all students" Click="ForceAll_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </DockPanel>

            <UniformGrid r:Responsive.CellWidth="215">
                <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,12,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12" Background="#3D8BFF" VerticalAlignment="Center">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatTotal" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="Total students" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,12,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12" Background="#19B58A" VerticalAlignment="Center">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatActive" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="Active" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,12,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12" Background="#E5484D" VerticalAlignment="Center">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatInactive" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="Inactive" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,13" Margin="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12" Background="#F2A900" VerticalAlignment="Center">
                            <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatNever" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="Never signed in" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <DockPanel Margin="0,18,0,12">
                <TextBlock x:Name="Count" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <Grid Width="300" Margin="0,0,14,0">
                        <TextBox x:Name="Search" Padding="40,9,12,9" TextChanged="Search_Changed"/>
                        <TextBlock Text="&#xE721;" Style="{StaticResource IconGlyph}" FontSize="15" Foreground="#8B97B5" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock x:Name="SearchHint" Text="Search name, ID, class or email" Foreground="#A3AECA" VerticalAlignment="Center" Margin="41,0,0,0" IsHitTestVisible="False"/>
                    </Grid>
                    <ComboBox x:Name="ClassFilter" Width="150" Margin="0,0,14,0" VerticalAlignment="Center" SelectionChanged="ClassFilter_Changed" ToolTip="Filter by class"/>
                    <Border Background="#1A305AB4" CornerRadius="10" Padding="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="FilterAll" Content="All" GroupName="sf" IsChecked="True" Style="{StaticResource SegmentButton}" Click="Filter_Click"/>
                            <RadioButton x:Name="FilterActive" Content="Active" GroupName="sf" Style="{StaticResource SegmentButton}" Click="Filter_Click"/>
                            <RadioButton x:Name="FilterInactive" Content="Inactive" GroupName="sf" Style="{StaticResource SegmentButton}" Click="Filter_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>

            <Border x:Name="TableCard" Style="{StaticResource GridCard}">
                <Grid>
                    <DataGrid x:Name="Table" RowHeight="62" VerticalAlignment="Top" MouseDoubleClick="Grid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="STUDENT" Width="2.3*" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="38" Height="38" CornerRadius="19" Background="{Binding AvatarBg}">
                                                <TextBlock Text="{Binding Initial}" FontWeight="Bold" Foreground="{Binding AvatarFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Email}" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="STUDENT ID" Width="*" SortMemberPath="StudentId">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#EEF3FF" CornerRadius="8" Padding="9,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StudentId}" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BlueDarkBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="CLASS" Width="*" SortMemberPath="Department">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#F1ECFF" CornerRadius="8" Padding="9,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Department}" FontWeight="SemiBold" FontSize="12.5" Foreground="#5B3FD1"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="STATUS" Width="110" SortMemberPath="Status" CellTemplate="{StaticResource StatusCell}"/>
                            <DataGridTextColumn Header="EXAMS" Binding="{Binding Exams}" Width="80"/>
                            <DataGridTextColumn Header="LAST SIGN-IN" Binding="{Binding LastLogin}" Width="130"/>
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="&#xE70F;" ToolTip="Edit student" Style="{StaticResource IconButtonBlue}" Click="Edit_Click"/>
                                            <Button Content="&#xE81C;" ToolTip="Exam history" Style="{StaticResource IconButton}" Click="History_Click"/>
                                            <Button Content="&#xE192;" ToolTip="Set a new password" Style="{StaticResource IconButton}" Click="Reset_Click"/>
                                            <Button Content="&#xE7E8;" ToolTip="Sign out this student everywhere" Style="{StaticResource IconButton}" Click="ForceOut_Click"/>
                                            <Button Content="&#xE74D;" ToolTip="Delete student" Style="{StaticResource IconButtonDanger}" Click="Delete_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,30">
                        <Border Style="{StaticResource IllustrationPanel}" Width="300" HorizontalAlignment="Center"><Image Source="/Assets/admin-students.png"/></Border>
                        <TextBlock x:Name="EmptyTitle" Text="No students yet" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,18,0,4"/>
                        <TextBlock x:Name="EmptyText" Text="Click “Add student” to create the first one." Style="{StaticResource Muted}" TextAlignment="Center" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Text="Tip: double-click a row to edit. Use the key icon to set a new password for a student; passwords are only ever changed here." Style="{StaticResource Muted}" FontSize="12" Margin="4,12,0,8"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
