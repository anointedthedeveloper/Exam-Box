<UserControl x:Class="ExamBox.Admin.StudentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Students" Style="{StaticResource H1}"/>
                <TextBlock x:Name="Count" Style="{StaticResource Muted}"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="270" Margin="0,0,12,0">
                    <TextBox x:Name="Search" Padding="40,10,12,10" TextChanged="Search_Changed"/>
                    <TextBlock Text="&#xE721;" Style="{StaticResource IconGlyph}" FontSize="15" Foreground="#8B97B5" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock x:Name="SearchHint" Text="Search name, ID or email" Foreground="#A3AECA" VerticalAlignment="Center" Margin="41,0,0,0" IsHitTestVisible="False"/>
                </Grid>
                <Button Style="{StaticResource PrimaryButton}" Click="Add_Click" Margin="0">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Add student" VerticalAlignment="Center"/></StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
            <Button x:Name="EditBtn" Style="{StaticResource GhostButton}" Click="Edit_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Edit" VerticalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="HistoryBtn" Style="{StaticResource GhostButton}" Click="History_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Exam history" VerticalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="ResetBtn" Style="{StaticResource GhostButton}" Click="Reset_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE192;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Reset password" VerticalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="DeleteBtn" Style="{StaticResource DangerButton}" Click="Delete_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Delete" VerticalAlignment="Center"/></StackPanel></Button>
            <TextBlock x:Name="Hint" Text="Select a student to enable these actions · double-click a row to edit" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
        </StackPanel>

        <Border Style="{StaticResource GridCard}">
            <Grid>
                <DataGrid x:Name="Table" RowHeight="58" SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Grid_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="STUDENT" Width="2.2*" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource BlueLightBrush}">
                                            <TextBlock Text="{Binding Initial}" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Email}" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="STUDENT ID" Binding="{Binding StudentId}" Width="*"/>
                        <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="*"/>
                        <DataGridTemplateColumn Header="STATUS" Width="110" SortMemberPath="Status" CellTemplate="{StaticResource StatusCell}"/>
                        <DataGridTextColumn Header="EXAMS" Binding="{Binding Exams}" Width="80"/>
                        <DataGridTextColumn Header="LAST LOGIN" Binding="{Binding LastLogin}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Border Style="{StaticResource IllustrationPanel}" Width="320" HorizontalAlignment="Center"><Image Source="/Assets/admin-students.png"/></Border>
                    <TextBlock x:Name="EmptyTitle" Text="No students yet" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,18,0,4"/>
                    <TextBlock x:Name="EmptyText" Text="Click “Add student” to create the first one." Style="{StaticResource Muted}" TextAlignment="Center" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
