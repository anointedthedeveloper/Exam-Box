@model List<Exam>
@{ ViewData["Title"] = "Exams"; }
<div class="page-head"><div><h1>Exams</h1><p>Create exams, add questions and publish them to students.</p></div>
<a class="btn" asp-action="Create">New exam</a></div>
<div class="card flush">
@if (Model.Count == 0) { <div class="empty">No exams yet. Create one to get started.</div> }
else
{
    <table><thead><tr><th>Title</th><th>Questions</th><th>Duration</th><th>Pass mark</th><th>Submissions</th><th>Status</th></tr></thead><tbody>
    @foreach (var e in Model)
    {
        <tr><td><a asp-action="Details" asp-route-id="@e.Id"><strong>@e.Title</strong></a></td>
            <td>@e.Questions.Count</td><td>@e.DurationMinutes min</td><td>@e.PassMarkPercent%</td>
            <td>@e.Attempts.Count(a => a.SubmittedAt != null)</td>
            <td><span class="badge @(e.IsPublished ? "ok" : "warn")">@(e.IsPublished ? "Published" : "Draft")</span></td></tr>
    }
    </tbody></table>
}
</div>
