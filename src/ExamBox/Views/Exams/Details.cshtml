@model Exam
@{ ViewData["Title"] = Model.Title; var locked = Model.Attempts.Any(); var total = Model.Questions.Sum(q => q.Marks); }
<div class="page-head"><div><div class="crumbs"><a asp-action="Index">Exams</a> /</div><h1>@Model.Title</h1>
<p>@Model.DurationMinutes min · pass mark @Model.PassMarkPercent% · @Model.Questions.Count question(s), @total mark(s) · <span class="badge @(Model.IsPublished ? "ok" : "warn")">@(Model.IsPublished ? "Published" : "Draft")</span></p></div>
<div class="actions">
    <form asp-action="TogglePublish" asp-route-id="@Model.Id" method="post"><button class="btn">@(Model.IsPublished ? "Unpublish" : "Publish")</button></form>
    <a class="btn ghost" asp-action="Results" asp-route-id="@Model.Id">Results (@Model.Attempts.Count(a => a.SubmittedAt != null))</a>
    <a class="btn ghost" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-confirm="Delete this exam, its questions and all student results?"><button class="btn danger">Delete</button></form>
</div></div>
@if (!string.IsNullOrWhiteSpace(Model.Description)) { <div class="card">@Model.Description</div> }
@if (locked) { <div class="alert alert-err" style="background:var(--warnbg);color:var(--warn)">Students have started this exam, so its questions are locked to keep grading consistent.</div> }
<div class="card flush">
    <div class="card-h"><h2 style="margin:0">Questions</h2>@if (!locked) { <a class="btn sm" asp-action="AddQuestion" asp-route-id="@Model.Id">Add question</a> }</div>
    @if (Model.Questions.Count == 0) { <div class="empty">No questions yet.</div> }
    else
    {
        var n = 0;
        foreach (var q in Model.Questions)
        {
            n++;
            <div style="padding:16px 20px;border-bottom:1px solid var(--line)">
                <div style="display:flex;justify-content:space-between;gap:12px"><strong>@n. @q.Text</strong><span class="badge">@q.Marks mark@(q.Marks == 1 ? "" : "s")</span></div>
                <ul style="margin:8px 0;padding-left:20px">
                @foreach (var o in q.Options()) { <li>@(o.Key == q.CorrectOption ? Html.Raw("<strong style='color:var(--ok)'>") : Html.Raw("<span>"))@o.Key. @o.Text@(o.Key == q.CorrectOption ? Html.Raw(" ✓</strong>") : Html.Raw("</span>"))</li> }
                </ul>
                @if (!locked)
                {
                    <div class="actions"><a class="btn ghost sm" asp-action="EditQuestion" asp-route-id="@Model.Id" asp-route-qid="@q.Id">Edit</a>
                    <form asp-action="DeleteQuestion" asp-route-id="@Model.Id" asp-route-qid="@q.Id" method="post" data-confirm="Delete this question?"><button class="btn danger sm">Delete</button></form></div>
                }
            </div>
        }
    }
</div>
