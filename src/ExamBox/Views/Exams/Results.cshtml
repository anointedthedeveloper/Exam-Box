@model Exam
@{ ViewData["Title"] = Model.Title + " results"; var done = Model.Attempts.Where(a => a.SubmittedAt != null).OrderByDescending(a => a.Score).ToList(); }
<div class="page-head"><div><div class="crumbs"><a asp-action="Index">Exams</a> / <a asp-action="Details" asp-route-id="@Model.Id">@Model.Title</a> /</div><h1>Results</h1>
<p>@done.Count submission(s)@(done.Count > 0 ? $" · average {Math.Round(done.Average(a => a.Percent), 1)}% · {done.Count(a => a.Percent >= Model.PassMarkPercent)} passed" : "")</p></div></div>
<div class="card flush">
@if (done.Count == 0) { <div class="empty">No submissions yet.</div> }
else
{
    <table><thead><tr><th>Student</th><th>ID</th><th>Score</th><th>Percent</th><th>Outcome</th><th>Submitted</th></tr></thead><tbody>
    @foreach (var a in done)
    {
        var pass = a.Percent >= Model.PassMarkPercent;
        <tr><td><a asp-controller="Students" asp-action="Details" asp-route-id="@a.StudentId">@a.Student!.FullName</a></td><td class="mono">@a.Student.Username</td>
            <td>@a.Score / @a.TotalMarks</td><td>@a.Percent%</td>
            <td><span class="badge @(pass ? "ok" : "err")">@(pass ? "Pass" : "Fail")</span></td>
            <td class="muted small"><time datetime="@a.SubmittedAt!.Value.ToString("o")"></time></td></tr>
    }
    </tbody></table>
}
</div>
