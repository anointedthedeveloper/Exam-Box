@model AdminDashboardVm
@{ ViewData["Title"] = "Dashboard"; }
<div class="page-head"><div><h1>Dashboard</h1><p>Overview of your students and exams.</p></div>
<div class="actions"><a class="btn ghost" asp-controller="Exams" asp-action="Create">New exam</a><a class="btn" asp-controller="Students" asp-action="Create">Add student</a></div></div>
<div class="stats">
    <div class="stat"><div class="n">@Model.Students</div><div class="l">Students</div><div class="s">@Model.ActiveStudents active</div></div>
    <div class="stat"><div class="n">@Model.Exams</div><div class="l">Exams</div><div class="s">@Model.PublishedExams published</div></div>
    <div class="stat"><div class="n">@Model.Completed</div><div class="l">Completed attempts</div><div class="s">@(Model.Attempts - Model.Completed) in progress</div></div>
    <div class="stat"><div class="n">@(Model.Completed == 0 ? "—" : Model.AvgPercent + "%")</div><div class="l">Average score</div><div class="s">across submitted exams</div></div>
</div>
<div class="grid2">
    <div class="card flush">
        <div class="card-h"><h2 style="margin:0">Recent submissions</h2></div>
        @if (Model.Recent.Count == 0) { <div class="empty">No submissions yet.</div> }
        else
        {
            <table><thead><tr><th>Student</th><th>Exam</th><th>Score</th></tr></thead><tbody>
            @foreach (var a in Model.Recent)
            {
                <tr><td><a asp-controller="Students" asp-action="Details" asp-route-id="@a.StudentId">@a.Student!.FullName</a></td>
                    <td>@a.Exam!.Title</td>
                    <td><span class="badge @(a.Percent >= a.Exam.PassMarkPercent ? "ok" : "err")">@a.Percent%</span></td></tr>
            }
            </tbody></table>
        }
    </div>
    <div class="card flush">
        <div class="card-h"><h2 style="margin:0">Newest students</h2><a href="/admin/students">View all</a></div>
        @if (Model.NewStudents.Count == 0) { <div class="empty">No students yet. <a asp-controller="Students" asp-action="Create">Add the first one</a>.</div> }
        else
        {
            <table><thead><tr><th>Name</th><th>ID</th></tr></thead><tbody>
            @foreach (var s in Model.NewStudents)
            {
                <tr><td><a asp-controller="Students" asp-action="Details" asp-route-id="@s.Id">@s.FullName</a></td><td class="mono">@s.Username</td></tr>
            }
            </tbody></table>
        }
    </div>
</div>
