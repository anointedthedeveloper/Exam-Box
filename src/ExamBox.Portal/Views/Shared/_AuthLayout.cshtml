<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · ExamBox</title>
    <link rel="icon" href="/assets/img/favicon.ico" sizes="any" />
    <link rel="stylesheet" href="/assets/css/site.css" />
</head>
<body class="auth-body">
    <main class="auth-wrap">
        <section class="auth-hero">
            <img src="/assets/img/logo.webp" alt="ExamBox" class="hero-logo" />
            <h1>ExamBox</h1>
            <p>Run exams, manage students and grade results — all in one box.</p>
            <ul class="hero-points">
                <li>Timed multiple-choice exams with instant grading</li>
                <li>Secure student accounts managed by your staff</li>
                <li>Live dashboards and result reports</li>
            </ul>
        </section>
        <section class="auth-card">
            @RenderBody()
        </section>
    </main>
    <script src="/assets/js/site.js"></script>
</body>
</html>
