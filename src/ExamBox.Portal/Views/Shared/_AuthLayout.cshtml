@inject PortalBrand Brand
<!DOCTYPE html>
<html lang="en">
<head>
    <script>document.documentElement.classList.add("js")</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · @Brand.Name</title>
    <link rel="icon" href="/assets/img/favicon.ico" sizes="any" />
    <link rel="stylesheet" href="/assets/css/site.css" />
</head>
<body class="auth-body">
    <div class="topbar"></div>
    <main class="auth-wrap">
        <section class="auth-hero">
            <span class="blob b1"></span><span class="blob b2"></span><span class="blob b3"></span>
            <div class="hero-brand"><img src="/assets/img/logo.png" alt="" /><span>@Brand.Name</span></div>
            <div class="slides">
                <figure class="slide s1"><img src="/assets/img/slide-exams.svg" alt="" /><figcaption><h2>Sit your exam with confidence</h2><p>Clear questions, one attempt, no surprises.</p></figcaption></figure>
                <figure class="slide s2"><img src="/assets/img/slide-timer.svg" alt="" /><figcaption><h2>Timed and fair</h2><p>A live countdown keeps you on track.</p></figcaption></figure>
                <figure class="slide s3"><img src="/assets/img/slide-results.svg" alt="" /><figcaption><h2>Instant results</h2><p>See your score and review every answer.</p></figcaption></figure>
                <figure class="slide s4"><img src="/assets/img/slide-devices.svg" alt="" /><figcaption><h2>Works on any device</h2><p>Use your laptop, tablet or phone.</p></figcaption></figure>
            </div>
            <div class="hero-chips"><span><svg viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>Timed</span><span><svg viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>Type your answers</span><span><svg viewBox="0 0 24 24"><path d="M7 2v11h3v9l7-12h-4l4-8z"/></svg>Instant results</span></div>
            <div class="dots"><i class="d1"></i><i class="d2"></i><i class="d3"></i><i class="d4"></i></div>
        </section>
        <section class="auth-card-wrap">
            <div class="auth-card">
                @RenderBody()
            </div>
            <p class="auth-foot">@Brand.Name · Secure exam portal</p>
        </section>
    </main>
    <div class="overlay" id="overlay"><div class="spinner lg"></div><p id="overlayMsg">Please wait…</p></div>
    <script src="/assets/js/site.js"></script>
</body>
</html>
