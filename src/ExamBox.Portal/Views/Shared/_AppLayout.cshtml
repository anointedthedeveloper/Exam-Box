@inject PortalBrand Brand
@{
    var ctrl = (ViewContext.RouteData.Values["controller"] as string ?? "").ToLowerInvariant();
    var act = (ViewContext.RouteData.Values["action"] as string ?? "").ToLowerInvariant();
    string Tab() => ctrl == "account" ? "account" : act switch { "exams" or "instructions" => "exams", "completed" or "result" => "completed", "take" => "exams", _ => "home" };
    var tab = Tab();
    string On(string t) => tab == t ? "active" : "";
    var initials = string.Concat((User.Identity?.Name ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));
    var first = (User.Identity?.Name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";
    const string icHome = "M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z";
    const string icExam = "M19 3h-4.18C14.4 1.84 13.3 1 12 1s-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z";
    const string icDone = "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z";
    const string icMe = "M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <script>document.documentElement.classList.add("js")</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · @Brand.Name</title>
    <link rel="icon" href="/assets/img/favicon.ico" sizes="any" />
    <link rel="stylesheet" href="/assets/css/site.css" />
</head>
<body>
<div class="topbar"></div>
<header class="nav-wrap">
    <div class="nav-capsule">
        <a class="brand" asp-controller="Portal" asp-action="Index"><img src="/assets/img/logo.png" alt="" /><span>@Brand.Name</span></a>
        <nav class="main-nav" id="mainNav">
            <span class="nav-pill" id="navPill"></span>
            <a class="@On("home")" asp-controller="Portal" asp-action="Index"><svg viewBox="0 0 24 24"><path d="@icHome"/></svg><span>Dashboard</span></a>
            <a class="@On("exams")" asp-controller="Portal" asp-action="Exams"><svg viewBox="0 0 24 24"><path d="@icExam"/></svg><span>Exams</span></a>
            <a class="@On("completed")" asp-controller="Portal" asp-action="Completed"><svg viewBox="0 0 24 24"><path d="@icDone"/></svg><span>Completed</span></a>
            <a class="@On("account")" asp-controller="Account" asp-action="Me"><svg viewBox="0 0 24 24"><path d="@icMe"/></svg><span>My account</span></a>
        </nav>
        <div class="me">
            <a class="me-chip" asp-controller="Account" asp-action="Me" title="My account"><span class="avatar">@initials</span><span class="me-info"><strong>@User.Identity!.Name</strong><small>Student</small></span></a>
            <form asp-controller="Account" asp-action="Logout" method="post"><button class="signout" title="Sign out">Sign out</button></form>
        </div>
    </div>
</header>
<nav class="tabbar" aria-label="Main">
    <a class="@On("home")" asp-controller="Portal" asp-action="Index"><svg viewBox="0 0 24 24"><path d="@icHome"/></svg><span>Home</span></a>
    <a class="@On("exams")" asp-controller="Portal" asp-action="Exams"><svg viewBox="0 0 24 24"><path d="@icExam"/></svg><span>Exams</span></a>
    <a class="@On("completed")" asp-controller="Portal" asp-action="Completed"><svg viewBox="0 0 24 24"><path d="@icDone"/></svg><span>Completed</span></a>
    <a class="@On("account")" asp-controller="Account" asp-action="Me"><svg viewBox="0 0 24 24"><path d="@icMe"/></svg><span>Account</span></a>
</nav>
<main class="content @(tab == "home" ? "is-dash" : "")">
    <partial name="_Flash" />
    @RenderBody()
</main>
<div class="modal" id="confirmModal" aria-hidden="true">
    <div class="modal-box" role="dialog" aria-modal="true">
        <div class="modal-ic"><svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg></div>
        <h3 id="modalTitle">Are you sure?</h3>
        <p id="modalText" class="muted"></p>
        <div class="modal-actions"><button type="button" class="btn ghost" id="modalNo">Go back</button><button type="button" class="btn" id="modalYes">Yes, continue</button></div>
    </div>
</div>
<div class="submit-overlay" id="submitOverlay" aria-hidden="true">
    <div class="so-box">
        <svg class="so-ring" viewBox="0 0 120 120"><circle class="so-track" cx="60" cy="60" r="50"/><circle class="so-arc" cx="60" cy="60" r="50"/><path class="so-check" d="M38 62l15 15 30-34"/></svg>
        <h3 id="soTitle">Submitting your exam…</h3>
        <p id="soText" class="muted">Please don't close this page.</p>
    </div>
</div>
<div class="overlay" id="overlay"><div class="spinner lg"></div><p id="overlayMsg">Please wait…</p></div>
<script src="/assets/js/site.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
