@inject PortalBrand Brand
@{
        var ctrl = (ViewContext.RouteData.Values["controller"] as string ?? "").ToLowerInvariant();
    string Active(params string[] c) => c.Contains(ctrl) ? "active" : "";
    var initials = string.Concat((User.Identity?.Name ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · @Brand.Name</title>
    <link rel="icon" href="/assets/img/favicon.ico" sizes="any" />
    <link rel="stylesheet" href="/assets/css/site.css" />
</head>
<body>
<div class="topbar"></div>
<div class="shell">
    <aside class="sidebar">
        <a class="brand" href="/"><img src="/assets/img/logo.png" alt="" /><span>@Brand.Name</span></a>
        <nav>
                <a class="@Active("portal")" asp-controller="Portal" asp-action="Index">My dashboard</a>
            <a class="@Active("account")" asp-controller="Account" asp-action="ChangePassword">Change password</a>
        </nav>
        <div class="me">
            <div class="avatar">@initials</div>
            <div class="me-info"><strong>@User.Identity!.Name</strong><small>Student</small></div>
            <form asp-controller="Account" asp-action="Logout" method="post"><button class="link-btn" title="Sign out">Sign out</button></form>
        </div>
    </aside>
    <main class="content">
        <partial name="_Flash" />
        @RenderBody()
    </main>
</div>
<div class="overlay" id="overlay"><div class="spinner lg"></div><p id="overlayMsg">Please wait…</p></div>
<script src="/assets/js/site.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
