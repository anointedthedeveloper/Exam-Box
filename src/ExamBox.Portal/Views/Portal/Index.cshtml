@model StudentHome
@{ ViewData["Title"] = "My dashboard"; var done = Model.Completed; }
<div class="hero-banner">
    <div>
        <h1>Hello, @Model.Student.FullName.Split(' ')[0] 👋</h1>
        <p>Here's what's happening with your exams.</p>
        <div class="chips">
            <span class="chip">ID: @Model.Student.Username</span>
            <span class="chip">@Model.Available.Count available</span>
            <span class="chip">@done.Count completed</span>
            @if (done.Any(a => !a.PendingMarking)) { <span class="chip">Average @(Math.Round(done.Where(a => !a.PendingMarking).Average(a => a.Percent), 1))%</span> }
        </div>
    </div>
    <img src="/assets/img/slide-exams.svg" alt="" />
</div>

@if (Model.InProgress.Count > 0)
{
    <div class="callout"><strong>You have an exam in progress.</strong>
    @foreach (var a in Model.InProgress) { <div style="margin-top:8px">@a.Exam!.Title — <a class="btn sm" asp-action="Take" asp-route-id="@a.Id">Resume</a></div> }</div>
}

<h2 class="section-title">Available exams</h2>
@if (Model.Available.Count == 0)
{
    <div class="card empty-card">
        <div class="illus"><img src="/assets/img/slide-timer.svg" alt="" /></div>
        <strong>Nothing to take right now</strong>
        <div>New exams will show up here when your teacher launches them.</div>
    </div>
}
else
{
    <div class="exam-grid">
    @foreach (var e in Model.Available)
    {
        <div class="exam-card">
            <h3>@e.Title</h3>
            <p>@(string.IsNullOrWhiteSpace(e.Description) ? "No extra instructions." : e.Description)</p>
            <div class="meta"><span>@e.Questions.Count(q => q.Marks > 0) questions</span>@if (e.Questions.Any(q => q.Type == QuestionType.Theory)) { <span>@(e.Questions.Any(q => q.Type == QuestionType.Objective) ? "Objective + theory" : "Theory")</span> }<span>@e.DurationMinutes min</span><span>Pass @e.PassMarkPercent%</span></div>
            <form asp-action="Start" asp-route-examId="@e.Id" method="post" data-confirm="Start '@e.Title'? The timer starts immediately and you only get one attempt." data-loading="Starting your exam…" data-overlay>
                <button class="btn block"><span class="lbl">Start exam</span><span class="spinner sm"></span></button>
            </form>
        </div>
    }
    </div>
}

@if (Model.Upcoming.Count > 0)
{
    <h2 class="section-title">Coming up</h2>
    <div class="exam-grid">
    @foreach (var e in Model.Upcoming)
    {
        <div class="exam-card soon">
            <h3>@e.Title</h3>
            <p>@(string.IsNullOrWhiteSpace(e.Description) ? "Not open yet." : e.Description)</p>
            <div class="meta"><span>@e.DurationMinutes min</span><span>Opens <time datetime="@e.OpensAt!.Value.ToString("o")"></time></span></div>
            <button class="btn block" disabled>Not open yet</button>
        </div>
    }
    </div>
}

<h2 class="section-title">My results</h2>
<div class="card flush">
@if (done.Count == 0) { <div class="empty">You haven't completed any exams yet.</div> }
else
{
    <table><thead><tr><th>Exam</th><th>Score</th><th>Outcome</th><th>Submitted</th><th></th></tr></thead><tbody>
    @foreach (var a in done)
    {
        var pass = a.Percent >= a.Exam!.PassMarkPercent;
        <tr><td><strong>@a.Exam.Title</strong></td>
            @if (a.PendingMarking) { <td class="muted">Objective @a.ObjectiveScore so far</td><td><span class="badge warn">Awaiting marking</span></td> }
            else { <td>@a.Score / @a.TotalMarks (@a.Percent%)</td><td><span class="badge @(pass ? "ok" : "err")">@(pass ? "Pass" : "Fail")</span></td> }
            <td class="muted small"><time datetime="@a.SubmittedAt!.Value.ToString("o")"></time></td>
            <td class="right"><a class="btn ghost sm" asp-action="Result" asp-route-id="@a.Id">Review</a></td></tr>
    }
    </tbody></table>
}
</div>
