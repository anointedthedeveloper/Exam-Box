@model StudentHome
@{ ViewData["Title"] = "My dashboard"; var done = Model.Completed; }
<div class="hero-banner">
    <div>
        <h1>Hello, @Model.Student.FullName.Split(' ')[0] 👋</h1>
        <p>Here's what's happening with your exams.</p>
        <div class="chips"><span class="chip">ID: @Model.Student.Username</span>@if (!string.IsNullOrWhiteSpace(Model.Student.Department)) { <span class="chip">Class: @Model.Student.Department</span> }</div>
    </div>
    <img src="/assets/img/slide-exams.svg" alt="" />
</div>

<div class="stats">
    <div class="stat"><div class="n">@Model.Available.Count</div><div class="l">Available now</div><div class="s">Ready for you to start</div></div>
    <div class="stat"><div class="n">@Model.Upcoming.Count</div><div class="l">Coming up</div><div class="s">Scheduled by your teacher</div></div>
    <div class="stat"><div class="n">@Model.InProgress.Count</div><div class="l">In progress</div><div class="s">Resume any time before time is up</div></div>
    <div class="stat"><div class="n">@done.Count</div><div class="l">Completed</div><div class="s">Exams you have handed in</div></div>
</div>

@if (Model.InProgress.Count > 0)
{
    <div class="callout"><strong>You have an exam in progress.</strong>
    @foreach (var a in Model.InProgress) { <div style="margin-top:8px">@a.Exam!.Title — <a class="btn sm" asp-action="Take" asp-route-id="@a.Id">Resume</a></div> }</div>
}

<h2 class="section-title">Available exams</h2>
@if (Model.Available.Count == 0)
{
    <div class="card empty-card">
        <div class="illus"><img src="/assets/img/slide-timer.svg" alt="" /></div>
        <strong>Nothing to take right now</strong>
        <div>New exams will show up here when your teacher launches them.</div>
    </div>
}
else
{
    <div class="exam-grid">
    @foreach (var e in Model.Available)
    {
        <div class="exam-card">
            <div class="ec-top"><span class="ec-ic">✎</span><span class="badge ok live"><i></i>Open now</span></div>
            <h3>@e.Title</h3>
            <p>@(string.IsNullOrWhiteSpace(e.Description) ? "No extra instructions." : e.Description)</p>
            <div class="meta"><span>@e.Questions.Count(q => q.Marks > 0) question@(e.Questions.Count(q => q.Marks > 0) == 1 ? "" : "s")</span>@if (e.Questions.Any(q => q.Type == QuestionType.Theory)) { <span>@(e.Questions.Any(q => q.Type == QuestionType.Objective) ? "Objective + theory" : "Theory")</span> }<span>@e.DurationMinutes min</span><span>Pass @e.PassMarkPercent%</span></div>
            <form asp-action="Start" asp-route-examId="@e.Id" method="post" data-confirm="The timer starts immediately and you only get one attempt at '@e.Title'. Ready?" data-confirm-title="Start this exam?" data-loading="Starting your exam…" data-overlay>
                <button class="btn block"><span class="lbl">Start exam</span><span class="spinner sm"></span></button>
            </form>
        </div>
    }
    </div>
}

@if (Model.Upcoming.Count > 0)
{
    <h2 class="section-title">Coming up</h2>
    <div class="exam-grid">
    @foreach (var e in Model.Upcoming)
    {
        <div class="exam-card soon">
            <div class="ec-top"><span class="ec-ic soon">⏳</span><span class="badge warn">Not open yet</span></div>
            <h3>@e.Title</h3>
            <p>@(string.IsNullOrWhiteSpace(e.Description) ? "Not open yet." : e.Description)</p>
            <div class="meta"><span>@e.DurationMinutes min</span><span>Opens <time datetime="@e.OpensAt!.Value.ToString("o")"></time></span><span class="cd">in <b data-countdown="@e.OpensAt!.Value.ToString("o")"></b></span></div>
            <button class="btn block" disabled>Not open yet</button>
        </div>
    }
    </div>
}

<h2 class="section-title">Completed exams</h2>
<div class="card flush">
@if (done.Count == 0) { <div class="empty">You haven't completed any exams yet.</div> }
else
{
    <table><thead><tr><th>Exam</th><th>Status</th><th>Submitted</th></tr></thead><tbody>
    @foreach (var a in done)
    {
        <tr><td><strong>@a.Exam!.Title</strong></td>
            <td><span class="badge ok">Completed</span></td>
            <td class="muted small"><time datetime="@a.SubmittedAt!.Value.ToString("o")"></time></td></tr>
    }
    </tbody></table>
}
</div>
