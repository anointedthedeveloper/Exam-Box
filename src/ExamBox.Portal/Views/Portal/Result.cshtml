@model Attempt
@{
    var e = Model.Exam!;
    ViewData["Title"] = e.Title + " submitted";
    var answerable = e.Questions.Where(q => !QLabel.IsPassage(q)).ToList();
    var answered = answerable.Count(q => Model.Answers.Any(a => a.QuestionId == q.Id && (a.Selected != null || !string.IsNullOrWhiteSpace(a.Text))));
}
<div class="page-head"><div><div class="crumbs"><a asp-action="Index">My exams</a> / Completed</div><h1>@e.Title</h1></div></div>
<div class="card done-card">
    <svg class="done-ic" viewBox="0 0 100 100"><circle cx="50" cy="50" r="46"/><path d="M30 52l14 14 27-30"/></svg>
    <h2>Exam completed</h2>
    <p class="muted">Your answers have been recorded. Your teacher will share the results with you.</p>
    <div class="done-meta">
        <span>@answered of @answerable.Count answered</span>
        <span>Submitted <time datetime="@Model.SubmittedAt!.Value.ToString("o")"></time></span>
    </div>
    <a class="btn lg" asp-action="Index">Back to my exams</a>
</div>
