@model TakeExamVm
@{ ViewData["Title"] = Model.Exam.Title; var n = 0; }
<div class="timer" id="timer">
    <div><strong>@Model.Exam.Title</strong><div class="prog"><span id="answered">0</span> of @Model.Questions.Count answered</div></div>
    <div class="t" id="clock">--:--</div>
</div>
<form method="post" id="examForm" asp-action="Submit" asp-route-id="@Model.Attempt.Id" data-loading="Submitting and grading your exam…" data-overlay>
@foreach (var q in Model.Questions)
{
    n++;
    <div class="q"><div class="q-h"><span><span class="q-num">@n</span>@q.Text</span><span class="badge">@q.Marks mark@(q.Marks == 1 ? "" : "s")</span></div>
    @foreach (var o in q.Options())
    {
        <label class="opt"><input type="radio" name="q_@q.Id" value="@o.Key" /><span><strong>@o.Key.</strong> @o.Text</span></label>
    }</div>
}
<div class="actions"><button class="btn lg" id="submitBtn"><span class="lbl">Submit exam</span><span class="spinner sm"></span></button></div>
</form>
@section Scripts {
<script>
(function () {
  var left = @Model.SecondsLeft, form = document.getElementById('examForm'), clock = document.getElementById('clock'),
      timer = document.getElementById('timer'), answered = document.getElementById('answered'), end = Date.now() + left * 1000, sent = false;
  function pad(n) { return String(n).padStart(2, '0'); }
  function tick() {
    var s = Math.max(0, Math.round((end - Date.now()) / 1000));
    clock.textContent = pad(Math.floor(s / 60)) + ':' + pad(s % 60);
    timer.classList.toggle('low', s <= 60);
    if (s <= 0 && !sent) { sent = true; form.submit(); }
  }
  function count() { answered.textContent = new Set(Array.from(form.querySelectorAll('input[type=radio]:checked')).map(function (r) { return r.name; })).size; }
  form.addEventListener('change', count);
  tick(); setInterval(tick, 500);
  form.addEventListener('submit', function (e) {
    if (!sent && !confirm('Submit your exam now? You cannot change answers afterwards.')) { e.preventDefault(); return; }
    sent = true;
  });
  window.addEventListener('beforeunload', function (e) { if (!sent) { e.preventDefault(); e.returnValue = ''; } });
})();
</script>
}
