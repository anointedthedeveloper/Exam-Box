@model TakeExamVm
@{
    ViewData["Title"] = Model.Exam.Title;
    var labels = QLabel.Build(Model.Questions);
    var objective = Model.Questions.Where(q => q.Type == QuestionType.Objective).ToList();
    var theory = Model.Questions.Where(q => q.Type == QuestionType.Theory).ToList();
    var gradable = Model.Questions.Count(q => !QLabel.IsPassage(q));
}
<div class="timer" id="timer">
    <div><strong>@Model.Exam.Title</strong><div class="prog"><span id="answered">0</span> of @gradable answered · <span id="saved" class="saved">Saved</span></div></div>
    <div class="t" id="clock">--:--</div>
</div>
<div class="exam-layout">
<div class="exam-main">
<form method="post" id="examForm" asp-action="Submit" asp-route-id="@Model.Attempt.Id" data-loading="Submitting your exam…" data-overlay>
@if (!string.IsNullOrWhiteSpace(Model.Exam.Description))
{
    <div class="callout">@Model.Exam.Description</div>
}
@if (objective.Count > 0)
{
    @if (theory.Count > 0) { <h2 class="section-title">Section A · Objective</h2><p class="muted">Choose the best answer for each question.</p> }
    foreach (var q in objective)
    {
        Model.Saved.TryGetValue(q.Id, out var sv);
        <div class="q" id="qb_@q.Id"><div class="q-h"><span><span class="q-num">@labels[q.Id]</span>@q.Text</span><span class="badge">@q.Marks mark@(q.Marks == 1 ? "" : "s")</span></div>
        @if (q.HasImage) { <img class="q-img" loading="lazy" src="/portal/media/@q.Id" alt="Picture for question @labels[q.Id]" /> }
        @foreach (var o in q.Options())
        {
            <label class="opt"><input type="radio" name="q_@q.Id" value="@o.Key" checked="@(sv?.Selected == o.Key)" /><span><strong>@o.Key.</strong> @o.Text</span></label>
        }</div>
    }
}
@if (theory.Count > 0)
{
    <h2 class="section-title">@(objective.Count > 0 ? "Section B · Theory" : "Theory")</h2>
    <p class="muted">Type your answers in the boxes. Your work is saved automatically as you write; no pen and paper needed.</p>
    foreach (var q in theory)
    {
        if (QLabel.IsPassage(q))
        {
            <div class="q passage" id="qb_@q.Id"><div class="q-h"><span><span class="q-num">@labels[q.Id]</span>@q.Text</span></div>
            @if (q.HasImage) { <img class="q-img" loading="lazy" src="/portal/media/@q.Id" alt="" /> }</div>
            continue;
        }
        Model.Saved.TryGetValue(q.Id, out var sv);
        <div class="q" id="qb_@q.Id"><div class="q-h"><span><span class="q-num">@labels[q.Id]</span>@q.Text</span><span class="badge">@q.Marks mark@(q.Marks == 1 ? "" : "s")</span></div>
        @if (q.HasImage) { <img class="q-img" loading="lazy" src="/portal/media/@q.Id" alt="Picture for question @labels[q.Id]" /> }
        <textarea class="theory" name="q_@q.Id" rows="6" maxlength="@AttemptService.MaxTheoryChars" placeholder="Type your answer to @labels[q.Id] here…" spellcheck="true">@sv?.Text</textarea>
        <div class="muted small right wc"></div></div>
    }
}
<div class="actions"><button class="btn lg" id="submitBtn"><span class="lbl">Submit exam</span><span class="spinner sm"></span></button></div>
</form>
</div>
<aside class="exam-side">
    <div class="side-card">
        <h3>Questions</h3>
        <div class="progress"><i id="bar" style="width:0%"></i></div>
        <p class="muted small" id="barText"></p>
        <div class="palette">
        @foreach (var q in Model.Questions.Where(q => !QLabel.IsPassage(q)))
        {
            <a href="#qb_@q.Id" data-q="@q.Id" data-type="@(q.Type == QuestionType.Theory ? "t" : "o")">@labels[q.Id]</a>
        }
        </div>
        <p class="muted small legend"><i class="lgd done"></i> answered <i class="lgd"></i> not yet</p>
    </div>
</aside>
</div>
@section Scripts {
<script>
(function () {
  var left = @Model.SecondsLeft, form = document.getElementById('examForm'), clock = document.getElementById('clock'),
      timer = document.getElementById('timer'), answered = document.getElementById('answered'), savedEl = document.getElementById('saved'),
      end = Date.now() + left * 1000, sent = false, dirty = false, saving = false;
  function pad(n) { return String(n).padStart(2, '0'); }
  function tick() {
    var s = Math.max(0, Math.round((end - Date.now()) / 1000));
    clock.textContent = Math.floor(s / 3600) > 0 ? Math.floor(s / 3600) + ':' + pad(Math.floor(s / 60) % 60) + ':' + pad(s % 60) : pad(Math.floor(s / 60)) + ':' + pad(s % 60);
    timer.classList.toggle('low', s <= 60);
    if (s <= 0 && !sent) { sent = true; form.submit(); }
  }
  function count() {
    var n = new Set(Array.from(form.querySelectorAll('input[type=radio]:checked')).map(function (r) { return r.name; })).size;
    form.querySelectorAll('textarea.theory').forEach(function (t) {
      if (t.value.trim()) n++;
      t.parentNode.querySelector('.wc').textContent = t.value.trim() ? t.value.trim().split(/\s+/).length + ' words' : '';
    });
    answered.textContent = n;
    var pal = document.querySelectorAll('.palette a'), done = 0;
    pal.forEach(function (a) {
      var id = a.dataset.q, ok;
      if (a.dataset.type === 'o') ok = !!form.querySelector('input[name="q_' + id + '"]:checked');
      else { var t = form.querySelector('textarea[name="q_' + id + '"]'); ok = !!(t && t.value.trim()); }
      a.classList.toggle('done', ok); if (ok) done++;
    });
    var pct = pal.length ? Math.round(done * 100 / pal.length) : 0;
    document.getElementById('bar').style.width = pct + '%';
    document.getElementById('barText').textContent = done + ' of ' + pal.length + ' answered';
  }
  function state(t, cls) { savedEl.textContent = t; savedEl.className = 'saved ' + (cls || ''); }
  function save() {
    if (sent || saving || !dirty) return;
    saving = true; dirty = false; state('Saving…');
    fetch(location.pathname + '/save', { method: 'POST', body: new FormData(form), credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (j) { saving = false; if (j.ok) { state('Saved', 'ok'); end = Date.now() + j.left * 1000; } else { state(j.error || 'Not saved', 'bad'); } })
      .catch(function () { saving = false; dirty = true; state('Offline — will retry', 'bad'); });
  }
  function touched() { dirty = true; count(); state('Unsaved changes'); }
  form.addEventListener('change', touched);
  form.addEventListener('input', touched);
  count(); state('Saved', 'ok'); tick(); setInterval(tick, 500); setInterval(save, 15000);
  document.addEventListener('visibilitychange', function () { if (document.hidden) save(); });
  form.addEventListener('submit', function (e) {
    if (!sent && !confirm('Submit your exam now? You cannot change answers afterwards.')) { e.preventDefault(); return; }
    sent = true;
  });
  window.addEventListener('beforeunload', function (e) { if (!sent) { save(); e.preventDefault(); e.returnValue = ''; } });
})();
</script>
}
