@model ChangePasswordVm
@{ ViewData["Title"] = "Change password"; var forced = User.HasClaim("mcp", "1"); }
<div class="page-head"><div><h1>Change password</h1>
<p>@(forced ? "You're using a temporary password. Choose your own to continue." : "Choose a password you will remember.")</p></div></div>
<div class="card form-card">
    <form method="post" data-loading="Updating…">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        <label asp-for="CurrentPassword">Current password</label>
        <input asp-for="CurrentPassword" autocomplete="current-password" />
        <span asp-validation-for="CurrentPassword" class="field-validation-error"></span>
        <label asp-for="NewPassword">New password</label>
        <input asp-for="NewPassword" autocomplete="new-password" />
        <span asp-validation-for="NewPassword" class="field-validation-error"></span>
        <label asp-for="ConfirmPassword">Confirm new password</label>
        <input asp-for="ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
        <div class="form-actions"><button class="btn"><span class="lbl">Update password</span><span class="spinner sm"></span></button></div>
    </form>
</div>
