@model ChangePasswordVm
@{ ViewData["Title"] = "Change password"; var forced = User.HasClaim("mcp", "1"); }
<div class="page-head"><div><div class="crumbs">Account</div><h1>Change password</h1></div></div>
<div class="pw-card">
    <aside class="pw-side">
        <div class="pw-shield"><svg viewBox="0 0 24 24"><path d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3zm-1 14-4-4 1.4-1.4L11 13.2l4.6-4.6L17 10l-6 6z"/></svg></div>
        <h2>@(forced ? "Choose your own password" : "Keep your account safe")</h2>
        <p>@(forced ? "You're using a temporary password from your teacher. Set one only you know to continue." : "Pick a password you will remember and nobody else can guess.")</p>
        <ul>
            <li>Don't share it with anyone, even friends.</li>
            <li>Avoid your name or birthday.</li>
            <li>You'll use it next time you sign in.</li>
        </ul>
    </aside>
    <div class="pw-form">
    <form method="post" data-loading="Updating…">
        <div asp-validation-summary="ModelOnly" class="form-alert"></div>
        <label asp-for="CurrentPassword">Current password</label>
        <div class="input-wrap"><svg class="ic" viewBox="0 0 24 24"><path d="M17 9V7a5 5 0 0 0-10 0v2H5v12h14V9zm-8-2a3 3 0 0 1 6 0v2H9zm3 10a2 2 0 1 1 0-4 2 2 0 0 1 0 4z"/></svg><input asp-for="CurrentPassword" autocomplete="current-password" /><button type="button" class="eye" data-show-pw="CurrentPassword" aria-label="Show or hide password" title="Show or hide password"><svg viewBox="0 0 24 24"><path d="M12 5C7 5 2.7 8.1 1 12c1.7 3.9 6 7 11 7s9.3-3.1 11-7c-1.7-3.9-6-7-11-7zm0 11.5a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9zm0-7a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z"/></svg></button></div>
        <span asp-validation-for="CurrentPassword" class="field-validation-error"></span>
        <label asp-for="NewPassword">New password</label>
        <div class="input-wrap"><svg class="ic" viewBox="0 0 24 24"><path d="M17 9V7a5 5 0 0 0-10 0v2H5v12h14V9zm-8-2a3 3 0 0 1 6 0v2H9zm3 10a2 2 0 1 1 0-4 2 2 0 0 1 0 4z"/></svg><input asp-for="NewPassword" autocomplete="new-password" /><button type="button" class="eye" data-show-pw="NewPassword" aria-label="Show or hide password" title="Show or hide password"><svg viewBox="0 0 24 24"><path d="M12 5C7 5 2.7 8.1 1 12c1.7 3.9 6 7 11 7s9.3-3.1 11-7c-1.7-3.9-6-7-11-7zm0 11.5a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9zm0-7a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z"/></svg></button></div>
        <span asp-validation-for="NewPassword" class="field-validation-error"></span>
        <label asp-for="ConfirmPassword">Confirm new password</label>
        <div class="input-wrap"><svg class="ic" viewBox="0 0 24 24"><path d="M17 9V7a5 5 0 0 0-10 0v2H5v12h14V9zm-8-2a3 3 0 0 1 6 0v2H9zm3 10a2 2 0 1 1 0-4 2 2 0 0 1 0 4z"/></svg><input asp-for="ConfirmPassword" autocomplete="new-password" /><button type="button" class="eye" data-show-pw="ConfirmPassword" aria-label="Show or hide password" title="Show or hide password"><svg viewBox="0 0 24 24"><path d="M12 5C7 5 2.7 8.1 1 12c1.7 3.9 6 7 11 7s9.3-3.1 11-7c-1.7-3.9-6-7-11-7zm0 11.5a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9zm0-7a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z"/></svg></button></div>
        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
        <div class="match" id="match"></div>
        <div class="form-actions"><button class="btn lg"><span class="lbl">Update password</span><span class="spinner sm"></span></button>
        @if (!forced) { <a class="btn ghost lg" asp-controller="Portal" asp-action="Index">Cancel</a> }</div>
    </form>
    </div>
</div>
@section Scripts {
<script>
(function () {
  var n = document.getElementById('NewPassword'), c = document.getElementById('ConfirmPassword'), m = document.getElementById('match');
  function check() {
    if (!c.value) { m.textContent = ''; m.className = 'match'; return; }
    var ok = n.value === c.value;
    m.textContent = ok ? '✓ Passwords match' : 'Passwords do not match yet';
    m.className = 'match ' + (ok ? 'ok' : 'bad');
  }
  n.addEventListener('input', check); c.addEventListener('input', check);
})();
</script>
}
